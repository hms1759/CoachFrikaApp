@{
    ViewData["Title"] = "Contact";
    ViewData["BodyClass"] = "about-page";
}

<!-- First Segment: Contains 1 Child -->
<div class="space"> </div>
<!-- First Segment: Contains 1 Child -->
<div class="space"> </div>
<br />
<div class="contact-container">
    <div class="contact-info-card">
        <h2 class="contact-heading">Get in Touch</h2>
        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/email.png" />
            </span>
            <div>
                <strong>Email Address</strong>
                <p>info@coachtfklab.org</p>
            </div>
        </div>
        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/vector.png" />
            </span>
            <div>
                <strong>Phone Number</strong>
                <p>+234 816 412 4811</p>
            </div>
        </div>
        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/vector1.png" />
            </span>
            <div>
                <strong>Office Address</strong>
                <p>No. 3 Alakosoak, Phase 2, Sanni Road, Okunore, Abeokuta, Ogun State, Nigeria.</p>
            </div>
        </div>
    </div>

    <div class="contact-form-card">
        <h2 class="contact-form-title">Send Us Direct Message</h2>
        <form id="contact-form">
            <input type="text" class="contact-input" placeholder="Enter Your Full Name" required />
            <div class="contact-row">
                <input type="email" class="contact-input" placeholder="Your Email Address" required />
                <input type="tel" class="contact-input" placeholder="Your Phone Number" required />
            </div>
            <textarea class="contact-textarea" placeholder="Write a message about your request" required></textarea>
            <button type="submit" class="contact-button">Send</button>
        </form>
    </div>
</div>
<div class="space"> </div>
<div class="space"> </div>
