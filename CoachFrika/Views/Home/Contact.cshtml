@{
    ViewData["Title"] = "Contact";
    ViewData["BodyClass"] = "about-page";
}
<!-- First Segment: Contains 1 Child -->
<div>
<div class="space"> </div>
<div class="container d-flex contact justify-content-around">
    <div class="about-founder-countaine contact-founder">
        <div class="contactAddress">
            <div class="contactAddress-topic">
                Get in Touch
            </div>
            <br />
            <div class="contactBody">
                <div class="d-flex">
                    <div>
                        <img src="~/images/email.png" />

                    </div>
                    <div class="contactBody-BB">
                        <div class="contactBody-topic">Email Address</div>
                        <div>info@coachfrika.org</div>
                    </div>
                </div>
            </div>

            <br />
            <div class="contactBody"> 
                <div class="d-flex ">
                    <div>
                        <img src="~/images/vector.png" />
                    </div>
                    <div class="contactBody-BB">
                        <div class="contactBody-topic">Phone Number</div>
                        <div>+234 816 412 4811  </div>
                    </div>
                </div>
            </div>

            <br />
            <div class="contactBody">
                <div class="d-flex">
                    <div>
                        <img src="~/images/vector1.png" />
                    </div>
                    <div class="contactBody-BB">
                        <div class="contactBody-topic">Office Address</div>
                        <div>
                            No 3, Alakaloka, Phase 2,
                            Sanni Road, Olomoore,
                            Abeokuta, Ogun State,
                            Nigeria.
                        </div>
                    </div>
                </div>
            </div>

            <br />
        </div>

    </div>
    <div class=" about-founder-countaine about-founder contactus-form">
        <form class="p-4">
            <div class="mb-3">
                <label for="fullName" class="form-label">Enter Your Full Name</label>
                <input type="text" class="form-control" id="fullName" placeholder="Enter Your Full Name" required>
            </div>

            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="email" class="form-label">Your Email Address</label>
                    <input type="email" class="form-control" id="email" placeholder="Your Email Address" required>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="phone" class="form-label">Your Phone Number</label>
                    <input type="tel" class="form-control" id="phone" placeholder="Your Phone Number" required>
                </div>
            </div>

            <div class="mb-3">
                <label for="message" class="form-label">Write Your Message *</label>
                <textarea class="form-control" id="message" rows="5" placeholder="Write Your Message *" required></textarea>
            </div>

            <div class="d-flex justify-content-center align-items-center">
                <button type="submit" class="contact-submit">Submit</button>
            </div>
        </form>

    </div>
</div>

<div class="space"> </div>
<div class="space"> </div>
<div class="space"> </div>
</div>
