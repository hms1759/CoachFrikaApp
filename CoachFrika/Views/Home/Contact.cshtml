@{
    ViewData["Title"] = "Contact";
    ViewData["BodyClass"] = "about-page";
}

<!-- Spacing Segments -->
<div class="space"></div>
<div class="space"></div>
<br />

<div class="contact-container">
    <!-- Contact Information -->
    <div class="contact-info-card">
        <h2 class="contact-heading">Get in Touch</h2>

        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/email.png" alt="Email Icon" />
            </span>
            <div>
                <strong>Email Address</strong>
                <p>info@coachtfklab.org</p>
            </div>
        </div>

        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/vector.png" alt="Phone Icon" />
            </span>
            <div>
                <strong>Phone Number</strong>
                <p>+234 816 412 4811</p>
            </div>
        </div>

        <div class="contact-info-item">
            <span class="contact-icon">
                <img src="~/images/vector1.png" alt="Location Icon" />
            </span>
            <div>
                <strong>Office Address</strong>
                <p>No. 3 Alakosoak, Phase 2, Sanni Road, Okunore, Abeokuta, Ogun State, Nigeria.</p>
            </div>
        </div>
    </div>

    <!-- Contact Form -->
    <div class="contact-form-card">
        <h2 class="contact-form-title">Send Us Direct Message</h2>
        <form id="contact-form">
            <input type="text" class="contact-input" name="FullName" placeholder="Enter Your Full Name" required />

            <div class="contact-row">
                <input type="email" class="contact-input" name="Email" placeholder="Your Email Address" required />
                <input type="tel" class="contact-input" name="PhoneNumber"
                       placeholder="Your Phone Number"
                       pattern="^\+?[0-9]{7,15}$"
                       title="Enter a valid phone number (7-15 digits, optional + at start)"
                       required />
            </div>

            <textarea class="contact-textarea" name="Message" placeholder="Write a message about your request" required></textarea>

            <!-- Anti-bot Checkbox -->
            <div style="margin: 10px 0;">
                <input type="checkbox" id="not-robot" required />
                <label for="not-robot">I'm not a robot</label>
            </div>

            <button type="submit" class="contact-button">Send</button>
        </form>
    </div>
</div>

<div class="space"></div>
<div class="space"></div>

<!-- Toastr CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

<!-- jQuery & Toastr JS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- Toastr Config -->
<script>
    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: "toast-top-right",
        timeOut: "5000"
    };
</script>

<!-- JS Form Handler -->
<script>
    document.getElementById('contact-form').addEventListener('submit', function (e) {
        e.preventDefault();

        const fullName = document.querySelector('input[name="FullName"]').value.trim();
        const email = document.querySelector('input[name="Email"]').value.trim();
        const phone = document.querySelector('input[name="PhoneNumber"]').value.trim();
        const message = document.querySelector('textarea[name="Message"]').value.trim();
        const isHuman = document.getElementById('not-robot').checked;

        const phoneRegex = /^\+?[0-9]{7,15}$/;
        if (!phoneRegex.test(phone)) {
            toastr.warning('Invalid phone number format.');
            return;
        }

        if (!isHuman) {
            toastr.warning('Please confirm you are not a robot.');
            return;
        }

        const payload = {
            fullName: fullName,
            email: email,
            phoneNumber: phone,
            message: message
        };

        fetch('/api/ContactUs/CreateContactUs', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(response => {
            if (!response.ok) throw new Error("Network error");
            return response.json();
        })
        .then(data => {
            toastr.success('Message sent successfully!');
            document.getElementById('contact-form').reset();
        })
        .catch(error => {
            console.error('Error:', error);
            toastr.error('Failed to send message.');
        });
    });
</script>
