@{
    ViewData["Title"] = "About";
}
<div class="container">
    <!-- First Segment -->
    <div class="row mb-5">
        <div class="col-md-5 p-4 bg-white shadow-lg rounded-3">First Child</div>
        <div class="col-md-5 offset-md-2 p-4 bg-white shadow-lg rounded-3">Second Child</div>
    </div>

    <!-- Second Segment -->
    <div class="text-center mb-4">
        <h2 class="fw-bold">Centralized Topic</h2>
    </div>

    <!-- Card List -->
    <div class="row g-4">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
            <div class="col"><div class="card p-3">Card 1</div></div>
            <div class="col"><div class="card p-3">Card 2</div></div>
            <div class="col"><div class="card p-3">Card 3</div></div>
            <div class="col"><div class="card p-3">Card 4</div></div>
            <div class="col"><div class="card p-3">Card 5</div></div>
            <div class="col"><div class="card p-3">Card 6</div></div>
        </div>
    </div>
</div>
