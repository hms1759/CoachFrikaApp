@{
    ViewData["Title"] = "Service";
}
<div class="container">
    <!-- Section: Personalized Coaching -->
    <section class="services-section services-coaching">
        <div class="services-container">
            <div class="services-text">
                <h2 class="services-title">We Provide Personalized <br>Coaching Services</h2>
                <p class="services-description">Our coaching services are designed to empower educators with the skills and confidence they need. Each session is customized to meet your personal teaching needs.</p>
            </div>
            <div class="services-image">
                <img src="~/images/headcoach.png" alt="Coach" class="services-img">
            </div>
        </div>
    </section>

    <!-- Section: One-on-One Mentorship -->
    <section class="services-section services-mentorship ddimg">
        <div class="services-container services-reverse">
          
            <div class="services-text">
                <h2 class="services-title">We Provide One-On-One Mentorship</h2>
                <p class="services-description">Mentorship is at the heart of effective professional development. We connect you with experienced mentors to support and guide you through your teaching journey.</p>
            </div>  <div class="services-image">
                <img src="~/images/teacher&coach.png" alt="Mentorship" class="services-img">
            </div>
        </div>
    </section>

    <!-- Section: Call to Action -->
    <section class="services-section services-cta ddimg2">
        <div class="services-cta-container">
            <div class="services-cta-text">
                <h2 class="services-title">Elevate your teaching journey with our exclusive one-on-one Coaching</h2>
                <div class="make_extra">Our Teachers make extra cash outside their primary <br/> salaries</div>
                <div class="make_extra_join">Join us to know how they do it</div>
                <a href="#" class="services-button">Get Started</a>
            </div>
            <div class="services-image">
                <img src="~/images/galwithhair.png" alt="Coaching Call to Action" class="services-img">
            </div>
        </div>
    </section>

