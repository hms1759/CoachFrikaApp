@model PublicCountDto
@{
    ViewData["Title"] = "Home Page";
    ViewData["BodyClass"] = "home-page";
}

<div>
    <!-- div 1: Two children widely spaced -->
    <div class="d-flex justify-content-between">
        <div class="side-text1">
            <div class="Personalized-text-box">
                Personalized Coaching Support for Teachers and Educators.
            </div>
            <div class="Empowering-text-box">
                Empowering Africa's Educators Through A Modern and  Smart Approach.
            </div>
            <div class="nnb_join">
                Join Us
            </div>

            <div class="support-board">
                <div class="Supported-text-box">
                    Supported and Trusted by
                </div>
                <div class="grouped-img-box flex">
                    <div class="group-img"><img src="~/images/group.jpg" /></div>
                    <div class="group-img"><img src="~/images/logo svg_imgid1.jpg" /></div>
                    <div class="group-img"><img src="~/images/logo svg_imgid2.jpg" /></div>
                </div>
            </div>
        </div>
        <div class="side-image"> <img src="~/images/side.png" /></div>
    </div>

    <!-- div 2:  4 children -->
    <div class="record boxel d-flex justify-content-around align-items-center text-white flex-wrap">
        <div class="record-child"> <div class="record-child-value"> 3</div> <div class="record-child-const"> Leader Coaches Onboarded</div></div>
        <div class="record-child"> <div class="record-child-value"> 5</div> <div class="record-child-const"> Schools benefitted</div></div>
        <div class="record-child"> <div class="record-child-value"> 10</div> <div class="record-child-const"> Teacher Leaders Onboarded</div></div>
        <div class="record-child"> <div class="record-child-value"> 500+</div> <div class="record-child-const"> students Impacted</div></div>
    </div>

    <!-- div 3: Two children widely spaced -->
    <div class="boxel mission d-flex">
        <div class="mission-child-1">
            <div class="mission-child-1-backgrnd">
                <div class="mission-child-header">
                    Mission & Vision
                </div>
                <div class="mission-child-mission">
                    <div class="mission-child-topic">Mission</div>
                    <div class="mission-child-content">Empowering Educators, Transforming Futures </div>
                </div>
                <div class="mission-child-mission">
                    <div class="mission-child-topic ">Vision</div>
                    <div class="mission-child-content">
                        Coachfrika is committed to equipping educators
                        with the tools, skills, and mindset necessary
                        to become effective leaders in their classrooms
                        and communities. Through personalized coaching and
                        professional development, we strive to enhance
                        teaching practices, foster leadership qualities, and
                        improve learning outcomes, ultimately creating a positive
                        ripple effect throughout the education system.
                    </div>
                </div>
            </div>
        </div>
        <div class="mission-child-2 ">
            <div class="mission-child-2-header">
                We Provide An Unparalleled Support To Teachers Through Personalized Coaching
            </div>
            <div class="mission-child-content boxel">
                Our commitment is to provide personalized support through modern solutions.
                Whether you are a private teacher seeking clarity or public school educators
                wanting to enhance your classroom experience,
                then you can trust us to deliver excellence in
                providing that support you are longing for!
            </div>
            <div class="">
                <div class="mission-child-radios">
                    <div><img src="~/images/check_circle.png" /></div>
                    <div> Personalized Coaching</div>
                </div>
                <div class="mission-child-radios">
                    <div><img src="~/images/check_circle.png" /></div>
                    <div> Talent & Leadership Development</div>
                </div>
                <div class="mission-child-radios">
                    <div><img src="~/images/check_circle.png" /></div>
                    <div>
                        21st century Teaching Skills
                    </div>
                </div>

            </div>
            <div class="mission-child-btn">
                <div class="nnWH_join">
                    Join Us
                </div>
            </div>
        </div>
    </div>

    <!-- div 4: Centralized Topic + Carousel -->
    <div class=" Featured-Coaches boxel text-center">
