@{
    ViewData["Title"] = "Pricing";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    @@media (max-width: 1024px) {
        .services-container

    {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    }

    @@media (max-width: 768px) {
        .priceContent, .you_Know

    {
        font-family: "Roboto Flex", sans-serif;
        font-weight: 400;
        font-size: 28px;
        line-height: 100%;
    }

    .fqaClass {
        width: 100% !important;
    }

    }
</style>

<div class="container">
    <!-- Ready Section -->
    <section class="ready-section py-5">
        <div class="row justify-content-center text-center mb-4">
            <div class="col-md-8">
                <h2 class="animate__animated animate__fadeInDown">Are You Ready To Take Your Teaching Career To New Heights?</h2>
                <p class="animate__animated animate__fadeInUp">
                    Join Coachtrika's exclusive subscription model and embark on a transformative experience that will empower you as an educator and leader.
                    Our subscription is designed to provide you with ongoing support, professional development, and a thriving community of like-minded educators.
                </p>
                <a class="btn btn-success animate__animated animate__pulse animate__infinite" asp-controller="Account" asp-action="SignUp">Get Started</a>
            </div>
        </div>
    </section>

    <!-- Packages Section -->
    <section class="packages-section py-5">
        <div class="text-center mb-5">
            <h2 class="animate__animated animate__fadeIn">Our Packages</h2>
            <p class="animate__animated animate__fadeIn">Choose from our range of subscription plans that best suit your needs</p>
        </div>

        <div class="row justify-content-center">
            <!-- Package 1 -->
            <div class="col-md-4 mb-4 animate__animated animate__fadeInLeft">
                <div class="package-card">
                    <div class="card-header-wrapper header-one">
                        <h5 class="package-title">Intentional Teacher-<br />Leader</h5>
                    </div>
                    <p class="package-price">₦50,000</p>
                    <ul class="package-features">
                        <li><i class="fas fa-check-circle text-success"></i> 4 Coaching Sessions</li>
                        <li><i class="fas fa-check-circle text-success"></i> Access to Resource Library</li>
                        <li><i class="fas fa-check-circle text-success"></i> Certificate</li>
                    </ul>
                    <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                </div>
            </div>

            <!-- Package 2 -->
            <div class="col-md-4 mb-4 animate__animated animate__fadeInUp">
                <div class="package-card">
                    <div class="card-header-wrapper header-two">
                        <h5 class="package-title">Phenomenal Teacher-<br />Leader</h5>
                    </div>
                    <p class="package-price">₦70,000</p>
                    <ul class="package-features">
                        <li><i class="fas fa-check-circle text-success"></i> 6 Coaching Sessions</li>
                        <li><i class="fas fa-check-circle text-success"></i> Access to Resource Library</li>
                        <li><i class="fas fa-check-circle text-success"></i> Access to 20+ Global Teacher Community</li>
                        <li><i class="fas fa-check-circle text-success"></i> Exclusive webinars</li>
                        <li><i class="fas fa-check-circle text-success"></i> Certificate</li>
                    </ul>
                    <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                </div>
            </div>

            <!-- Package 3 -->
            <div class="col-md-4 mb-4 animate__animated animate__fadeInRight">
                <div class="package-card">
                    <div class="card-header-wrapper header-three">
                        <h5 class="package-title">Transformational Teacher-<br />Leader</h5>
                    </div>
                    <p class="package-price">₦100,000</p>
                    <ul class="package-features">
                        <li><i class="fas fa-check-circle text-success"></i> 9 Coaching Sessions</li>
                        <li><i class="fas fa-check-circle text-success"></i> Access to Resource Library</li>
                        <li><i class="fas fa-check-circle text-success"></i> Access to Global Teacher Community</li>
                        <li><i class="fas fa-check-circle text-success"></i> Certificate of participation</li>
                        <li><i class="fas fa-check-circle text-success"></i> Exclusive webinars</li>
                        <li><i class="fas fa-check-circle text-success"></i> 3 Months mentorship</li>
                        <li><i class="fas fa-check-circle text-success"></i> Certificate</li>
                    </ul>
                    <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Sponsor Section -->
    <section class="section-container py-5 animate__animated animate__fadeIn">
        <div class="row align-items-center">
            <div class="col-md-6">
                <img src="~/images/sponsorchild.png" alt="Child Image" class="img-fluid" />
            </div>
            <div class="col-md-6">
                <div class="you_Know">Do You Know</div>
                <div class="mb-4 you_Know">That</div>
                <div class="you_Know">With ₦30,000</div>
                <p>You can give a child access to quality education through a professional teacher in a low-income community.</p>
                <a href="#" class="cta-button mt-4" data-bs-toggle="modal" data-bs-target="#sponsorModal">Sponsor a Child</a>
            </div>
        </div>
    </section>

    <!-- Sponsor Modal -->
    <div class="modal fade" id="sponsorModal" tabindex="-1" aria-labelledby="sponsorModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content p-3">
                <div class="modal-header">
                    <h5 class="modal-title">Sponsor a Child</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="sponsorForm">
                    <div class="modal-body">
                        <div class="mb-3"><label>Sponsor Name</label><input type="text" class="form-control" name="SponsorName" required></div>
                        <div class="mb-3"><label>Sponsor Email</label><input type="email" class="form-control" name="SponsorEmail" required></div>
                        <div class="mb-3"><label>Sponsor Phone Number</label><input type="tel" class="form-control" name="SponsorPhoneNumber" required></div>
                        <div class="mb-3"><label>Number of Children</label><input type="number" class="form-control" name="NumbersOfChildren" required></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Sponsor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- School Enrollment Section -->
    <section class="section-container animate__animated animate__fadeIn ddimg">
        <div class="teacher-section d-flex align-items-center">
            <div class="text-content">
                <div class="priceContent">We Provide Just What Every Great Teacher Needed To Become Exceptional At Their Profession.</div>
                <div class="priceContentText">
                    At the heart of CoachFilla lies a steadfast commitment to revolutionizing education through modern teaching methodologies...
                </div>
                <a href="#" class="price_services-button mt-3" data-bs-toggle="modal" data-bs-target="#priceContactAdminModal">Enroll Your School</a>
            </div>
            <div class="image-container">
                <img src="~/images/sponsorchild2.png" alt="Teacher Image" class="img-fluid" />
            </div>
        </div>
    </section>

    <!-- School Enrollment Modal -->
    <div class="modal fade" id="priceContactAdminModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content p-3">
                <div class="modal-header">
                    <h5 class="modal-title">School Enrollment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <form id="schoolEnrollmentForm">
                    <div class="modal-body">
                        <div class="mb-3"><label>School Name</label><input type="text" class="form-control" name="SchoolName" required></div>
                        <div class="mb-3"><label>School Address</label><input type="text" class="form-control" name="SchoolAddress" required></div>
                        <div class="mb-3"><label>Contact Person Name</label><input type="text" class="form-control" name="ContactPersonName" required></div>
                        <div class="mb-3"><label>Contact Person Email</label><input type="email" class="form-control" name="ContactPersonEmail" required></div>
                        <div class="mb-3"><label>Contact Person Phone</label><input type="tel" class="form-control" name="ContactPersonPhoneNumber" required></div>
                        <div class="mb-3"><label>Number of Teachers</label><input type="number" class="form-control" name="NumbersOfTeachers" required></div>
                        <div class="mb-3">
                            <label>Subscription</label>
                            <select class="form-select" name="Subscriptions" required>
                                <option value="">-- Select Subscription --</option>
                                <option value="0">Intentional</option>
                                <option value="1">Phenomenal</option>
                                <option value="2">Transformational</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-primary">Enroll</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- FAQ Section -->
    <section class="ddimg text-center py-5">
        <h2>FAQ</h2>
        <p>Frequently Asked Questions</p>
        <div class="accordion fqaClass mx-auto" id="faqAccordion"></div>
    </section>
</div>

<script>
    // Close modal helper
    function closeModal(modalId) {
        const modalEl = document.getElementById(modalId);
        if (modalEl) {
            const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
            modal.hide();
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.classList.remove("modal-open");
            document.body.style.removeProperty("padding-right");
        }
    }
    // School Enrollment
    $("#schoolEnrollmentForm").on("submit", async function (e) {
        e.preventDefault();
        const payload = Object.fromEntries(new FormData(this).entries());
        payload.NumbersOfTeachers = parseInt(payload.NumbersOfTeachers);
        payload.Subscriptions = parseInt(payload.Subscriptions);

        try {
            const response = await fetch("/api/Public/SchoolEnrollment", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + localStorage.getItem("authToken")
                },
                body: JSON.stringify(payload)
            });
            const result = await response.json();

            if (response.ok) {
                toastr.success(result?.message || "School enrolled successfully!");
                this.reset();
                closeModal("priceContactAdminModal");

                // ✅ Reload after short delay
                setTimeout(() => {
                    location.reload();
                }, 2000);
            } else {
                toastr.error(result?.message || "Failed to enroll school.");
            }
        } catch {
            toastr.error("An error occurred while enrolling school.");
        }
    });

    // Sponsorship
    $("#sponsorForm").on("submit", async function (e) {
        e.preventDefault();
        const payload = Object.fromEntries(new FormData(this).entries());

        try {
            const response = await fetch("/api/Public/SponsorAChild", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer " + localStorage.getItem("authToken")
                },
                body: JSON.stringify(payload)
            });
            const result = await response.json();

            if (response.ok) {
                toastr.success(result?.message || "Sponsorship submitted successfully!");
                this.reset();
                closeModal("sponsorModal");

                // ✅ Reload after short delay
                setTimeout(() => {
                    location.reload();
                }, 2000);
            } else {
                toastr.error(result?.message || "Failed to submit sponsorship.");
            }
        } catch {
            toastr.error("An error occurred while submitting sponsorship.");
        }
    });

</script>
