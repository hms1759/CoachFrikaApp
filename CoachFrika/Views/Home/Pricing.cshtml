@{
    ViewData["Title"] = "Pricing";
}
<style>

    @@media (max-width: 1024px) {
        .services-container{
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

    }
    @@media (max-width: 768px){
        .priceContent {
            font-family: Roboto Flex;
            font-weight: 400;
            font-size: 28px;
            line-height: 100%;
            vertical-align: middle;
            margin-bottom: 0px !important;
        }

        .fqaClass {
            width: 100% !important;
        }

        .you_Know, .priceContent {
            font-family: Roboto Flex;
            font-weight: 400;
            font-size: 28px;
            line-height: 100%;}
    }

</style>
<div class="container">
    
    <section class="ready-section py-5">
        <div class="container">
            <div class="row justify-content-center text-center mb-4">
                <div class="col-md-8">
                    <h2 class="animate__animated animate__fadeInDown">Are You Ready To Take Your Teaching Career To New Heights?</h2>
                    <p class="animate__animated animate__fadeInUp">Join Coachtrika's exclusive subscription model and embark on a transformative experience that will empower you as an educator and leader. Our subscription is designed to provide you with ongoing support, professional development, and a thriving community of like-minded educators.</p>
                    <a class="btn btn-success animate__animated animate__pulse animate__infinite" asp-controller="Account" asp-action="SignUp">Get Started</a>
                </div>
            </div>
        </div>
    </section>

    <section class="packages-section py-5">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-12">
                    <h2 class="animate__animated animate__fadeIn">Our Packages</h2>
                    <p class="animate__animated animate__fadeIn">Choose from our range of subscription plans that best suit your needs</p>
                </div>
            </div>


            <div class="row justify-content-center">
                <div class="col-md-4 mb-4 animate__animated animate__fadeInLeft">
                    <div class="package-card">
                        <div class="card-header-wrapper header-one">
                            <h5 class="package-title">Intentional Teacher-<br />Leader</h5>
                        </div>
                        <p class="package-price">₦50,000</p>
                        <ul class="package-features">
                            <li><i class="fas fa-check-circle text-success mr-2"></i> 4 Coaching Sessions</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                        </ul>
                        <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                    </div>
                </div>

                <div class="col-md-4 mb-4 animate__animated animate__fadeInUp">
                    <div class="package-card">
                        <div class="card-header-wrapper header-two">
                            <h5 class="package-title">Phenomenal Teacher-<br />Leader</h5>
                        </div>
                        <p class="package-price">₦70,000</p>
                        <ul class="package-features">
                            <li><i class="fas fa-check-circle text-success mr-2"></i> 6 Coaching Sessions</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Access to 20+ Global Teacher Community</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Exclusive webinars</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                        </ul>
                        <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                    </div>
                </div>

                <div class="col-md-4 mb-4 animate__animated animate__fadeInRight">
                    <div class="package-card">
                        <div class="card-header-wrapper header-three">
                            <h5 class="package-title">Transformational Teacher-<br/>Leader</h5>
                        </div>
                        <p class="package-price">₦100,000</p>
                        <ul class="package-features">
                            <li><i class="fas fa-check-circle text-success mr-2"></i> 9 Coaching Sessions</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Global Teacher Community</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate of participation</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Exclusive webinars</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> 3 Months mentorship</li>
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                        </ul>
                        <a class="btn-choose" asp-controller="Account" asp-action="SignUp">Choose Plan</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-container py-5 animate__animated animate__fadeIn">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="image-container">
                        <img src="~/images/sponsorchild.png" alt="Child Image" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="you_Know">Do You Know </div><div class="mb-4 you_Know">That</div>
                    <div class="you_Know">With #30,000</div>
                    <p>You can give a child access to quality education through a professional teacher in a low-income community.</p>
                    <a href="#" class="cta-button mt-4" data-bs-toggle="modal" data-bs-target="#priceContactAdminModal">Sponsor a Child</a>

                </div>
            </div>
        </div>
    </section>

    <section class="section-container animate__animated animate__fadeIn ddimg">
        <div class="container">
            <div class="teacher-section">
                <div class="text-content">
                    <div class="priceContent">We Provide Just What Every Great Teacher Needed To Become Exceptional At Their Profession.</div>
                    <div class ="priceContentText">
                        At the heart of CoachFilla lies a steadfast commitment to revolutionizing
                        education through modern teaching methodologies, 
                        preparing teachers and students for the dynamic 
                        demands of the future of work. Our innovative solutions
                        empower educators with cutting-edge tools, transforming 
                        classrooms into hubs of active engagement, personalized 
                        learning, and holistic development. Through our comprehensive
                        coaching programs, we cultivate a cadre of exceptional teachers,
                        equipped with the skills and knowledge to navigate the 
                        ever-evolving educational landscape.</div>
                    <div class="space"></div> 
                    <a href="#" class="price_services-button" data-bs-toggle="modal" data-bs-target="#priceContactAdminModal">Enroll Your School</a>

                </div>
                <div class="image-container">
                    <img src="~/images/sponsorchild2.png" alt="Teacher Image" />
                </div>
            </div>
        </div>
    </section>
    <section class="ddimg">
    <!-- Fifth Segment: FAQ -->
        <div class="container ddimg">
            <div class="faqheader d-flex justify-content-center">
                <div class="space"></div>
                <div class="space"></div>
                <div class="space"></div>
            <div>
                <div class="d-flex justify-content-center"><h2>FAQ</h2></div>
                <br />
                <div>Frequently Asked Questions</div>
            </div>
        </div>
        <div class=" d-flex justify-content-center fqaClass">
                <div class="accordion fqaClass" id="faqAccordion">
                <!-- FAQ 1 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            What types of aids does Coachfrika provide for schools?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Coachfrika provides schools with access to a powerful suite of tools designed to enhance teaching and learning. These include:
                            Personalized Teacher Coaching: Our platform connects teachers with experienced coaches for one-on-one support, tailored to their individual needs and challenges.
                            Professional Development Workshops: We offer a wide range of workshops on topics like classroom management, differentiated instruction, and assessment strategies, delivered by experienced educators.
                            Community Building: We foster a vibrant online community where teachers can connect, share best practices, and support each other.
                        </div>
                    </div>
                </div>
                <!-- FAQ 2 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            How can these aids benefit educators and students?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            These aids empower educators in several key ways:
                            Empowered teachers: Teachers that are coaches earns from coaching other teachers
                            Improved Teaching Practices: Teachers gain valuable insights and strategies to enhance their classroom instruction, making learning more engaging and effective for students.
                            Increased Confidence: Personalized coaching and support boost teacher confidence and motivation.
                            Enhanced Student Outcomes: Improved teaching practices directly translate to better learning outcomes for students, leading to increased student engagement and academic achievement.
                            Professional Growth: Teachers have the opportunity to develop their skills, expand their knowledge, and advance their careers.
                        </div>
                    </div>
                </div>
                <!-- FAQ 3 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            Is Coachfrika's technology compatible with existing classroom setups?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Yes, Coachfrika's solutions are designed to be easily integrated into existing classroom setups.
                            Our platform is accessible via any internet-connected device,
                            making it convenient for teachers to access resources and participate in online coaching sessions.
                        </div>
                    </div>
                </div>
                <!-- FAQ 4 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            Are there training programs available for teachers to effectively use these modern teaching aids?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Absolutely! Coachfrika provides comprehensive training programs to equip teachers with the skills
                            and knowledge they need to effectively utilize our platform and implement the strategies learned in their coaching sessions.
                            These training programs are designed to be user-friendly and accessible to teachers of all levels of technological proficiency.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    </section>

    <!-- Modal -->
    <div class="modal fade" id="priceContactAdminModal" tabindex="-1" aria-labelledby="contactAdminModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="contactAdminModalLabel">Contact Admin</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="mb-3">For this feature, please contact admin via:</p>
                    <p class="fw-bold">📱 WhatsApp: <a href="https://wa.me/2348068783985" target="_blank">+234 816 412 4811</a></p>
                    <p class="fw-bold">📧 Email: <a href="mailto:Afeeziyiola17@gmail.com">Afeeziyiola17@gmail.com</a></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>