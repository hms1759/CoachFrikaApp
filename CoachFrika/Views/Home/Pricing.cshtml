@{
    ViewData["Title"] = "Pricing";
}
<div class="container">
    <!-- First Segment: Contains 1 Child -->
    <section class="section bg-light">
        <div class="boxel bigcardContainer d-flex justify-content-center align-items-center">
            <div class="big-card">
                <div class="big-card-content">
                    ARE YOU READY TO TAKE YOUR TEACHING CAREER TO NEW HEIGHTS?
                </div>
                <div class="big-card-text">
                    Join Coachfrika's exclusive subscription mode and embark on a transformative experience
                    that will empower you as an educator and leader. Our subscription
                    is designed to provide you with ongoing support, professional development,
                    and a thriving community of like-minded educators.
                </div>
                <div class="d-flex justify-content-center align-items-center">
                    <div class="event_join">
                        Get Started
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Second Segment: Topic + 3 Cards Widely Spaced -->

    <div class="faqheader d-flex justify-content-center">
        <div>
            <div class="d-flex justify-content-center">
                <h2>Our Pricing Plans</h2>
            </div>
            <br />
            <div>Choose from our range of subscription plans that best suit your needs</div>
        </div>
    </div>
    <div class="container d-flex justify-content-center">
        <div class="card-spacing">
            <div>
                <div class="price-card-title t1"> <h2>Intentional Teacher-Leader</h2></div>
                <div class="price-card-body">

                    <p class="card-body-text">$19.99/month</p>
                    <ul>
                        <oi>4 Coaching Sessions</oi>
                        <oi>Access to Resource Library</oi>
                        <oi>Certificate</oi>
                    </ul>
                </div>
            </div>
            <div> Get Started</div>

        </div>
        <div class="col-md-3 card-spacing">
            <div class="card price-card">
                <div class="card-body">
                    <div class="price-card-title">Basic</div>
                    <div class="price-card-body">

                        <p class="card-body-text">$19.99/month</p>
                        <ul>
                            <oi>4 Coaching Sessions</oi>
                            <oi>Access to Resource Library</oi>
                            <oi>Certificate</oi>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 card-spacing">
            <div class="card price-card">
                <div class="card-body">
                    <div class="price-card-title">Basic</div>
                    <div class="price-card-body">

                        <p class="card-body-text">$19.99/month</p>
                        <ul>
                            <oi>4 Coaching Sessions</oi>
                            <oi>Access to Resource Library</oi>
                            <oi>Certificate</oi>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Third Segment: 2 Children Widely Separated -->
    <section class="section bg-light">
        <div class="container">
            <div class="wide-space">
                <div>
                    <h4>Feature 1</h4>
                    <p>Unlimited access</p>
                </div>
                <div>
                    <h4>Feature 2</h4>
                    <p>24/7 Support</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Fourth Segment: 2 Children Widely Separated -->
    <section class="section">
        <div class="container">
            <div class="wide-space">
                <div>
                    <h4>Additional Benefit 1</h4>
                    <p>Free upgrades</p>
                </div>
                <div>
                    <h4>Additional Benefit 2</h4>
                    <p>Early access to new features</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Fifth Segment: FAQ -->
    <div class="container ">
        <div class="faqheader d-flex justify-content-center">
            <div>
                <div class="d-flex justify-content-center"><h2>FAQ</h2></div>
                <br />
                <div>Frequently Asked Questions</div>
            </div>
        </div>
        <div class=" d-flex justify-content-center">
            <div class="accordion" id="faqAccordion">
                <!-- FAQ 1 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            What types of aids does Coachfrika provide for schools?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Coachfrika provides schools with access to a powerful suite of tools designed to enhance teaching and learning. These include:
                            Personalized Teacher Coaching: Our platform connects teachers with experienced coaches for one-on-one support, tailored to their individual needs and challenges.
                            Professional Development Workshops: We offer a wide range of workshops on topics like classroom management, differentiated instruction, and assessment strategies, delivered by experienced educators.
                            Community Building: We foster a vibrant online community where teachers can connect, share best practices, and support each other.
                        </div>
                    </div>
                </div>
                <!-- FAQ 2 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            How can these aids benefit educators and students?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            These aids empower educators in several key ways:
                            Empowered teachers: Teachers that are coaches earns from coaching other teachers
                            Improved Teaching Practices: Teachers gain valuable insights and strategies to enhance their classroom instruction, making learning more engaging and effective for students.
                            Increased Confidence: Personalized coaching and support boost teacher confidence and motivation.
                            Enhanced Student Outcomes: Improved teaching practices directly translate to better learning outcomes for students, leading to increased student engagement and academic achievement.
                            Professional Growth: Teachers have the opportunity to develop their skills, expand their knowledge, and advance their careers.
                        </div>
                    </div>
                </div>
                <!-- FAQ 3 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            Is Coachfrika's technology compatible with existing classroom setups?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Yes, Coachfrika's solutions are designed to be easily integrated into existing classroom setups.
                            Our platform is accessible via any internet-connected device,
                            making it convenient for teachers to access resources and participate in online coaching sessions.
                        </div>
                    </div>
                </div>
                <!-- FAQ 4 -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            Are there training programs available for teachers to effectively use these modern teaching aids?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body">
                            Absolutely! Coachfrika provides comprehensive training programs to equip teachers with the skills
                            and knowledge they need to effectively utilize our platform and implement the strategies learned in their coaching sessions.
                            These training programs are designed to be user-friendly and accessible to teachers of all levels of technological proficiency.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
