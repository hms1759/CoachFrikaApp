@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  @*   <link rel="stylesheet" href="~/css/styles.css"> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo-removebg-preview.jpg" />
                <button class="close-btn" id="toggleBtn">x</button>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="#dashboard" class="sidebar-item">
                        <i class="fas fa-house"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="#dashboard" class="sidebar-item">
                        <i class="fas fa-broadcast-tower"></i> Live
                    </a>
                </li>
                <li>
                    <a href="#schedule" class="sidebar-item">
                        <i class="fas fa-calendar-alt"></i> Schedule
                    </a>
                </li>
                <li>
                    <a href="#myCoach" class="sidebar-item">
                        <i class="fas fa-user-friends"></i> My Coach and I
                    </a>
                </li>
            </ul>
            <button class="logout-btn" id="logoutBtn">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </nav>


        <!-- Main Content Area -->
        <div class="main-content">
            <div id="page-container" class="page-content">

            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/slidebar.js"></script>
    <script>
        $(document).ready(function () {
            // Load default content
            $("#page-container").load("/Profile/Dashboard", function (response, status, xhr) {
                if (status === "error") {
                    console.error("Error loading content:", xhr.status, xhr.statusText);
                }
            });
            // Handle sidebar navigation
            $(".sidebar-item").on("click", function (e) {
                e.preventDefault();
                $(".sidebar-item").removeClass("active");
                $(this).addClass("active");

                const target = $(this).attr("href").substring(1);
                $("#page-container").load(`/Profile/${target}`);
            });
        });
        

    </script>
   

</body>
</html>
