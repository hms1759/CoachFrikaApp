@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Prevent caching -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <title>Dashboard</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Site Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo-removebg-preview.jpg" alt="Logo" />
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a href="#dashboard" class="sidebar-item">
                        <i class="fas fa-house"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a href="#schedule" class="sidebar-item">
                        <i class="fas fa-calendar-alt"></i> Schedule
                    </a>
                </li>

                <!-- Coach Only -->
                <li id="sidebarTeacherItem" style="display: none;">
                    <a href="#myCoach" class="sidebar-item">
                        <i class="fas fa-user-friends"></i> My Coach and I
                    </a>
                </li>

                <!-- Teacher Only -->
                <li id="sidebarCoachItem" style="display: none;">
                    <a href="#myTeacher" class="sidebar-item">
                        <i class="fas fa-user-friends"></i> My Teacher and I
                    </a>
                </li>

                <li>
                    <a href="#recomendations" class="sidebar-item">
                        <i class="fas fa-calendar-alt"></i> Recomendations
                    </a>
                </li>
            </ul>

            <button class="logout-btn" id="logoutBtn">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </nav>

        <!-- Toggle Button -->
        <button id="toggleBtn" class="sidebar-toggle-btn">
            <i class="fas fa-angle-double-left"></i>
        </button>

        <!-- Main Content -->
        <div class="main-content">
            <div id="page-container" class="page-content">
                <!-- AJAX content loads here -->
            </div>
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/slidebar.js"></script>

    <script>
        // Get token from session via Razor
        const userToken = @Html.Raw(Context.Session.GetString("Token") ?? "");

        function getUserRoleFromToken() {
            if (!userToken) return null;
            try {
                const payload = JSON.parse(atob(userToken.split('.')[1]));
                return payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || null;
            } catch (e) {
                console.error("Invalid token format:", e);
                return null;
            }
        }

        function showSidebarItemsByRole() {
            let role = getUserRoleFromToken();

            if (role === "Coach") {
                const coachItem = document.getElementById("sidebarCoachItem");
                if (coachItem) coachItem.style.display = "block";
            } else if (role === "Teacher") {
                const teacherItem = document.getElementById("sidebarTeacherItem");
                if (teacherItem) teacherItem.style.display = "block";
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            showSidebarItemsByRole();

            //Load dashboard with cache-busting timestamp
            $("#page-container").load(`/Profile/Dashboard?_=${new Date().getTime()}`, function (response, status, xhr) {
                if (status === "error") {
                    console.error("Error loading content:", xhr.status, xhr.statusText);
                }
            });

            // Sidebar link click - load page with timestamp
            $(".sidebar-item").on("click", function (e) {
                e.preventDefault();

                $(".sidebar-item").removeClass("active");
                $(this).addClass("active");

                const target = $(this).attr("href").substring(1); // remove '#'
                $("#page-container").load(`/Profile/${target}?_=${new Date().getTime()}`);
            });

            // Logout button logic
            const logoutBtn = document.getElementById("logoutBtn");
            if (logoutBtn) {
                logoutBtn.addEventListener('click', function () {
                    localStorage.removeItem("authToken");
                    sessionStorage.clear();
                    window.location.href = "/Account/Login";
                });
            }
        });

           logoutBtn.addEventListener('click', function () {
               localStorage.removeItem("authToken");
               sessionStorage.clear();
               window.location.href = "/Account/Login";
           });
    </script>

</body>
</html>
