@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <img src="~/images/logo-removebg-preview.jpg" />
                <button class="close-btn" id="toggleBtn">x</button>
            </div>
            <ul class="sidebar-menu">
                <li><a href="#dashboard" class="sidebar-item"><img src="~/images/vector2.png" />Dashboard</a></li>
                <li><a href="#report" class="sidebar-item"><img src="~/images/vector3.png" />Schedule</a></li>
                <li><a href="#settings" class="sidebar-item"><img src="~/images/ppl.png" />My Coach and I</a></li>
            </ul>
            <button class="logout-btn" id="logoutBtn">Logout</button>
        </nav>

        <!-- Main Content Area -->
        <div class="main-content">
            <div id="page-container" class="page-content">

            </div>
        </div>
    </div>
    <script src="~/js/slidebar.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Load default content
            $("#page-container").load("/Profile/Dashboard");

            // Handle sidebar navigation
            $(".sidebar-item").on("click", function (e) {
                e.preventDefault();
                const target = $(this).attr("href").substring(1); // remove '#'
                $("#page-container").load(`/Profile/${target}`);
            });
        });
    </script>
</body>
</html>
