<!-- Include Select2 CSS and JS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<!-- Toastr CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<!-- Toastr JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    /* ===== Coach Teacher List Section Styles ===== */
    #coachTeacherListSection {
        background: #ffffff;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0px 2px 10px rgba(0,0,0,0.08);
    }

        #coachTeacherListSection h2 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #333;
        }

    #coachTeacherSearchInput {
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 6px 10px;
        font-size: 14px;
    }

    .teacher-view-all-btn {
        /* background-color: #007bff; */
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 6px 12px;
        cursor: pointer;
        font-size: 14px;
        transition: background 0.3s ease;
    }

        .teacher-view-all-btn:hover {
            /* background-color: #0056b3; */
        }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    thead {
        background: #f4f4f4;
    }

    th, td {
        padding: 8px;
        border: 1px solid #ddd;
    }

    tr:hover {
        background-color: #f9f9f9;
    }

    .teacher-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 15px;
        gap: 10px;
    }

        .teacher-pagination button {
            padding: 5px 10px;
            border: none;
            /* background: #007bff; */
            color: #fff;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
        }

            .teacher-pagination button:hover {
                /* background: #0056b3; */
            }

        .teacher-pagination span {
            font-size: 14px;
            color: #333;
        }
</style>

<div class="space"></div>

<!-- Top Bar -->
<div class="teacher-top-bar">
    <span style="font-weight: bold; font-size: 18px;">Coach Recommendations</span>
    <div style="display:flex">
        <!-- Only for Coaches -->
        <div id="planTypeWrapper" style="display: none; margin-right: 10px;">
            <select id="planTypeSelect" class="teacher-search-input" onchange="handleRecomSearch()">
                <option value="">-- Select Plan Type --</option>
                <option value="Intentional">Intentional</option>
                <option value="Phenomenal">Phenomenal</option>
                <option value="Transformational">Transformational</option>
            </select>
        </div>
        <input type="text" style="margin-right: 10px" id="teacherSearchInput" class="teacher-search-input" placeholder="Search by name..." />
        <button class="teacher-view-all-btn" onclick="handleRecomSearch()">Search</button>

        <!-- Only for Coaches -->
        <span id="coachOnlyButtons" style="display: none;margin-left: 20px;">
            <button class="teacher-view-all-btn" onclick="openCreateRecModal()">+ Create Recommendation</button>
        </span>
    </div>
</div>

<div class="space"></div>

<!-- Recommendation Cards -->
<div class="teacher-card-wrapper" id="teacherCardWrapper">Loading Recommendations .....</div>

<!-- Pagination -->
<div class="teacher-pagination" id="teacherPagination">
    <button onclick="teacherGoToPreviousPage()">Previous</button>
    <span id="teacherPageInfo">Page 1</span>
    <button onclick="teacherGoToNextPage()">Next</button>
</div>

<div id="coachTeacherListSection" style="display:none; margin-top: 30px;">

    <!-- Search -->
    <div style="margin-bottom: 10px; display: flex; align-items: center; gap: 8px;">
        <h2 style="flex: 1;">Teachers List</h2>
        <input type="text" id="coachTeacherSearchInput" placeholder="Search by name..." />
        <button class="teacher-view-all-btn" onclick="handleCoachTeacherSearch()">Search</button>
    </div>

    <!-- Table -->
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Title</th>
                <th>School</th>
            </tr>
        </thead>
        <tbody id="coachTeacherTableBody">
            <tr><td colspan="3" style="text-align:center; padding:10px;">No data loaded</td></tr>
        </tbody>
    </table>

    <!-- Pagination -->
    <div class="teacher-pagination">
        <button onclick="coachTeacherPrevPage()">Previous</button>
        <span id="coachTeacherPageInfo">Page 1</span>
        <button onclick="coachTeacherNextPage()">Next</button>
    </div>
</div>
<!-- Create Recommendation Modal -->
<div id="createRecModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000;">
    <div style="background-color: white; padding: 20px; border-radius: 10px; width: 500px; max-width: 90%; position: relative;">
        <span onclick="closeCreateRecModal()" style="position: absolute; top: 10px; right: 15px; font-size: 24px; cursor: pointer;">×</span>
        <h2 style="margin-top: 0;">Create Recommendation</h2>
        <form id="createRecForm">
            <label for="scheduleDropdown" style="display: block; margin-top: 10px;">Schedule:</label>
            <select id="scheduleDropdown" name="ScheduleId" required style="width: 100%; padding: 8px; margin-top: 5px;"></select>

            <label for="teacherDropdown" style="display: block; margin-top: 15px;">Select Teachers:</label>
            <select id="teacherDropdown" name="TeacherIds" multiple required style="width: 100%; padding: 8px; margin-top: 5px;"></select>

            <label for="recommendationText" style="display: block; margin-top: 15px;">Recommendation:</label>
            <textarea id="recommendationText" name="Recommendation" required style="width: 100%; padding: 10px; height: 100px; margin-top: 5px;"></textarea>

            <button type="submit" style="margin-top: 20px; padding: 10px 15px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer;">Submit</button>
        </form>
    </div>
</div>

<script>
    let teacherToken = @Html.Raw(Context.Session.GetString("Token") ?? "");
    let teacherPageNumber = 1;
    const teacherPageSize = 10;
    let teacherSearchTerm = '';
    let selectedPlanType = '';
    let userRole = '';

    // Coach Teacher List variables
     let currentRecomendationId = null;
    let coachTeacherPageNumber = 1;
    let coachTeacherPageSize = 10;
    let coachTeacherSearchTerm = "";

    function handleRecomSearch() {
        teacherSearchTerm = document.getElementById("teacherSearchInput").value.trim();
        selectedPlanType = document.getElementById("planTypeSelect").value.trim();
        teacherPageNumber = 1;
        LoadRecomSearch();
    }

    function getUserRoleFromToken() {
        if (!teacherToken) return null;
        try {
            const payload = JSON.parse(atob(teacherToken.split('.')[1]));
            return payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || null;
        } catch (e) {
            console.error("Invalid token format:", e);
            return null;
        }
    }

    function showCoachUI() {
        userRole = getUserRoleFromToken();
        if (userRole === "Coach") {
            document.getElementById("coachOnlyButtons").style.display = "block";
            document.getElementById("planTypeWrapper").style.display = "block";
        }
    }

    function LoadRecomSearch() {
        const url = userRole === "Teacher"
            ? `/api/Teachers/GetAllRecommendations?ScheduleTitle=${encodeURIComponent(teacherSearchTerm)}&PageSize=${teacherPageSize}&PageNumber=${teacherPageNumber}`
            : `/api/Coaches/GetAllRecommendations?ScheduleTitle=${encodeURIComponent(teacherSearchTerm)}&PageSize=${teacherPageSize}&PageNumber=${teacherPageNumber}${selectedPlanType ? `&SelectedPlanType=${encodeURIComponent(selectedPlanType)}` : ''}`;

        fetch(url, {
            headers: { "Authorization": `Bearer ${teacherToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const wrapper = document.getElementById("teacherCardWrapper");
            wrapper.innerHTML = "";

            if (!data?.data?.length) {
                wrapper.innerHTML = "<p>No Recommendations found.</p>";
                return;
            }

            data.data.forEach(teacher => {
                const card = document.createElement("div");

        console.log(teacher)
                card.className = "teacher-card";

                const nameToShow = userRole === "Teacher"
                    ? (teacher.teachersName || "")
                    : (teacher.teachersName || teacher.coachName || "");

                card.innerHTML = `
                    <div class="teacher-card-content">
                        <p class="teacher-name">${teacher.scheduleTitle || ''}</p>
                        <p class="teacher-school">${teacher.recommendation || ''}</p>
                        <p class="teacher-school">${nameToShow}</p>
                        <div class="teacher-btn">
                            <button class="teacher-view-btn" onclick="showCoachTeacherList('${teacher.recommendation}')">View Details</button>
                        </div>
                    </div>
                `;
                wrapper.appendChild(card);
            });

            document.getElementById("teacherPageInfo").textContent = `Page ${teacherPageNumber}`;
        })
        .catch(err => {
            console.error("Error fetching teachers:", err);
            document.getElementById("teacherCardWrapper").innerHTML = "<p>Error loading teachers.</p>";
        });
    }

    function loadTeachers() {
        const url = userRole === "Teacher"
            ? `/api/Teachers/GetAllRecommendations?PageSize=${teacherPageSize}&PageNumber=${teacherPageNumber}`
            : `/api/Coaches/GetAllRecommendations?PageSize=${teacherPageSize}&PageNumber=${teacherPageNumber}`;

        fetch(url, {
            headers: { "Authorization": `Bearer ${teacherToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const wrapper = document.getElementById("teacherCardWrapper");
            wrapper.innerHTML = "";

            if (!data?.data?.length) {
                wrapper.innerHTML = "<p>No Recommendations found.</p>";
                return;
            }

            data.data.forEach(teacher => {
                const card = document.createElement("div");
                card.className = "teacher-card";

                const nameToShow = userRole === "Teacher"
                    ? (teacher.teachersName || "")
                    : (teacher.teachersName || teacher.coachName || "");

                card.innerHTML = `
                    <div class="teacher-card-content">
                        <p class="teacher-name">${teacher.scheduleTitle || ''}</p>
                        <p class="teacher-school">${teacher.recommendation || ''}</p>
                        <p class="teacher-school">${nameToShow}</p>
                        <div class="teacher-btn">
                            <button class="teacher-view-btn" onclick="showCoachTeacherList('${teacher.recommendation}')">View Details</button>
                        </div>
                    </div>
                `;
                wrapper.appendChild(card);
            });

            document.getElementById("teacherPageInfo").textContent = `Page ${teacherPageNumber}`;
        })
        .catch(err => {
            console.error("Error fetching teachers:", err);
            document.getElementById("teacherCardWrapper").innerHTML = "<p>Error loading teachers.</p>";
        });
    }

    function teacherGoToNextPage() {
        teacherPageNumber++;
        loadTeachers();
    }

    function teacherGoToPreviousPage() {
        if (teacherPageNumber > 1) {
            teacherPageNumber--;
            loadTeachers();
        }
    }

    // ==== Coach Teacher List functions ====
    function showCoachTeacherList(recommendationId) {
         if (userRole !== "Coach") return;
         currentRecomendationId = recommendationId;
         coachTeacherPageNumber = 1;
         document.getElementById("coachTeacherListSection").style.display = "block";
         loadCoachTeacherList();

         // Optional smooth scroll to section
         document.getElementById("coachTeacherListSection").scrollIntoView({ behavior: "smooth" });
     }

    function handleCoachTeacherSearch() {
         coachTeacherSearchTerm = document.getElementById("coachTeacherSearchInput").value.trim();
         coachTeacherPageNumber = 1;
         loadCoachTeacherList();
     }
     
      function loadCoachTeacherList() {

        console.log(currentRecomendationId)
        if (!currentRecomendationId) return;
        console.log(currentRecomendationId)
        const url = `/api/Coaches/GetRecommendationTeacherList?Recomendation=${encodeURIComponent(currentRecomendationId)}&IsPaginated=true&Name=${encodeURIComponent(coachTeacherSearchTerm)}&Pagesize=${coachTeacherPageSize}&PageNumber=${coachTeacherPageNumber}`;

        fetch(url, {
            headers: { "Authorization": `Bearer ${teacherToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const tbody = document.getElementById("coachTeacherTableBody");
            tbody.innerHTML = "";

            if (!data?.data?.length) {
                tbody.innerHTML = `<tr><td colspan="3" style="text-align:center; padding:10px;">No teachers found.</td></tr>`;
                return;
            }

            data.data.forEach(t => {
                tbody.innerHTML += `
                    <tr>
                        <td>${t.fullName || ''}</td>
                        <td>${t.title || ''}</td>
                        <td>${t.schoolName || ''}</td>
                    </tr>
                `;
            });

            document.getElementById("coachTeacherPageInfo").textContent = `Page ${coachTeacherPageNumber}`;
        })
        .catch(err => {
            console.error("Error loading teacher list:", err);
            toastr.error("Failed to load teacher list.");
        });
    }

    function coachTeacherNextPage() {
        coachTeacherPageNumber++;
        loadCoachTeacherList();
    }

    function coachTeacherPrevPage() {
        if (coachTeacherPageNumber > 1) {
            coachTeacherPageNumber--;
            loadCoachTeacherList();
        }
    }

    // ==== Modal Functions ====
    function openCreateRecModal() {
        document.getElementById("createRecModal").style.display = "flex";
        loadScheduleOptions();
    }

    function closeCreateRecModal() {
        document.getElementById("createRecModal").style.display = "none";
        document.getElementById("createRecForm").reset();
        $('#teacherDropdown').val(null).trigger('change');
    }

    function loadScheduleOptions() {
        fetch('/api/Scheduled/GetScheduleList', {
            headers: { "Authorization": `Bearer ${teacherToken}` }
        })
        .then(res => res.json())
        .then(res => {
            const dropdown = document.getElementById("scheduleDropdown");
            dropdown.innerHTML = `<option value="">-- Select Schedule --</option>`;
            res.data.forEach(s => {
                dropdown.innerHTML += `<option value="${s.id}">${s.title} (${s.focus})</option>`;
            });

            dropdown.onchange = function () {
                const selectedScheduleId = this.value;
                if (selectedScheduleId) {
                    loadTeacherOptions(selectedScheduleId);
                }
            };
        })
        .catch(() => toastr.error("Failed to load schedules."));
    }

    function loadTeacherOptions(scheduleId) {
        fetch(`/api/Scheduled/GetTeacherList?ScheduleId=${scheduleId}`, {
            headers: { "Authorization": `Bearer ${teacherToken}` }
        })
        .then(res => res.json())
        .then(res => {
            const dropdown = document.getElementById("teacherDropdown");
            dropdown.innerHTML = "";
            res.data.forEach(t => {
                dropdown.innerHTML += `<option value="${t.id}">${t.title} ${t.fullName}</option>`;
            });

            $('#teacherDropdown').select2({
                width: '100%',
                placeholder: 'Select teachers',
                allowClear: true
            });
        })
        .catch(() => toastr.error("Failed to load teachers."));
    }

    document.getElementById("createRecForm").addEventListener("submit", function (e) {
        e.preventDefault();

        const scheduleId = document.getElementById("scheduleDropdown").value;
        const teacherIds = $('#teacherDropdown').val();
        const recommendation = document.getElementById("recommendationText").value;

        const payload = {
            ScheduleId: scheduleId,
            TeacherIds: teacherIds,
            Recommendation: recommendation
        };

        fetch('/api/Coaches/AddTeachersRecomendations', {
            method: "POST",
            headers: {
                "Authorization": `Bearer ${teacherToken}`,
                "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
        })
        .then(async res => {
            const data = await res.json();
            if (!res.ok) {
                toastr.error(data?.message || data?.error || "An error occurred while creating recommendation.");
                throw new Error(data?.message || data?.error || "Error");
            }
            return data;
        })
        .then(() => {
            toastr.success("Recommendation created successfully!");
            closeCreateRecModal();
            loadTeachers();
        })
        .catch(err => {
            console.error("Error:", err);
        });
    });

    // Init
    showCoachUI();
    loadTeachers();
</script>
