@model Guid
@{
    Layout = null;
    ViewBag.Title = "Dashboard";
}
<script>
   const userId = "@Model";
    console.log(userId);
    </script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<style>
    .profile-card {
        font-family: 'Segoe UI', sans-serif;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #eee;
        background: #fff;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        max-width: 100%;
    }

    .profile-banner {
        background: #7ed321;
        padding: 40px 20px;
        color: white;
        position: relative;
    }

    .profile-banner-text {
        max-width: 50%;
        margin: auto;
        text-align: center;
    }

    .banner-camera {
        position: absolute;
        right: 20px;
        top: 20px;
        width: 30px;
    }

    .profile-info {
        display: flex;
        align-items: flex-start;
        padding: 20px;
        gap: 30px;
        flex-wrap: wrap;
    }

    .profile-image {
        position: relative;
        width: 150px;
        height: 150px;
        flex-shrink: 0;
        top: -8rem;
        margin-bottom: -6rem;
    }

        .profile-image img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 6px solid #fff;
            box-shadow: 0 0 6px rgba(0, 0, 0, 0.1);
        }

    .camera-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: #7ed321;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .camera-badge img {
            width: 16px;
        }

    .profile-details {
        flex: 1;
        min-width: 200px;
    }

        .profile-details h3 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }

        .profile-details .title {
            color: #555;
            margin-bottom: 10px;
        }

    .social-links {
        text-align: center;
        margin: 10px 0;
        color: gray;
    }

    .Schedules_null {
        max-width: 100%;
        height: 400px;
        text-align: center;
        justify-content: center;
        margin: 40px;
    }

    .social-links span {
        margin: 10px 0;
        font-family: Inter;
        font-weight: 600;
        font-size: 14px;
        line-height: 22px;
    }

    .social-links a {
        color: gray;
        margin: 10px 5px;
        text-decoration: none;
        font-size: 16px;
    }

    .experience {
        color: #3cb371;
        margin: 10px 0;
        font-size: 16px;
    }

        .experience strong {
            font-size: 20px;
        }

    .meta-info {
        margin-top: 10px;
        font-size: 15px;
        line-height: 1.8;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

        .meta-info i {
            margin-right: 8px;
            color: #3cb371;
        }

    .profile_description {
        font-family: Inter;
        font-weight: 400;
        font-size: 12px;
        line-height: 22px;
        text-align: justify;
    }

    .profile_social-links {
        font-family: Inter;
        font-weight: 400;
        font-size: 14px;
        line-height: 22px;
        text-align: center;
        color: #333;
    }

    .profile_name {
        font-family: Inter;
        font-weight: 600;
        font-size: 24px;
        line-height: 30px;
    }

    /*************************************/
    .activities-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

        .activities-header input {
            padding: 5px 10px;
            border-radius: 20px;
            border: 1px solid #ccc;
            flex-grow: 1;
        }

        .activities-header button {
            padding: 6px 12px;
            background: #6cc24a;
            color: white;
            border: none;
            border-radius: 4px;
            margin-left: 10px;
            flex-shrink: 0;
        }

    /* ============= RESPONSIVENESS ============= */
    @@media (max-width: 768px) {
        .profile-banner-text

    {
        max-width: 80%;
    }

    .profile-info {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-details {
        text-align: center;
    }

    .meta-info {
        justify-content: center;
    }

    .activities-header {
        flex-direction: column;
        align-items: stretch;
    }

        .activities-header input,
        .activities-header button {
            width: 100%;
            margin-left: 0;
        }

    }

    @@media (max-width: 425px) {
        .profile-image

    {
        width: 110px;
        height: 110px;
        top: -5rem;
        margin-bottom: -3rem;
    }

    .profile-details h3 {
        font-size: 18px;
    }

    .profile_name {
        font-size: 20px;
    }

    .profile-banner-text {
        max-width: 95%;
        font-size: 14px;
    }

    .meta-info {
        font-size: 13px;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .activities-header input {
        font-size: 14px;
    }

    .activities-header button {
        font-size: 14px;
        padding: 8px;
    }

    }
</style>

<div class="dashboard-container">
    <section>
        <div class="profile-card">
            <!-- Profile Banner -->
            <div class="profile-banner">
                <div class="profile-banner-text">
                    <img src="~/images/profilelogo-removebg-preview.png" alt="logo" />
                    <div id="profileDescription" class="profile_description">
                        Loading description...
                    </div>
                </div>
                <!-- Hidden file input -->
                <input type="file" id="profileImageInput" accept="image/*" style="display: none;" />

                <!-- Camera icon (clickable) -->
                <img src="~/images/photoicon.png" alt="camera" class="banner-camera" id="uploadTrigger" style="cursor:pointer;" />
            </div>

            <!-- Profile Info Section -->
            <div class="profile-info">
                <!-- Profile Image and Socials -->
                <div class="profile-image">
                    <img id="profileImage" src="~/images/default-avatar.png" alt="Profile" />
                    <div class="social-links">
                        <div><span>Follow me on</span></div>
                        <div id="socialLinks">
                            <!-- Filled dynamically -->
                        </div>
                    </div>
                </div>

                <div class="space"></div>

                <!-- Profile Details -->
                <div class="profile-details">
                    <div class="d-flex meta-info">
                        <div>
                            <div class="profile_topic">
                                <div id="profileName" class="profile_name">Loading...</div>
                                <div id="profileTitle" class="title">Loading...</div>
                            </div>
                            <div class="experience">
                                <strong>3+</strong> <span>Years Of Experience</span>
                            </div>
                        </div>

                        <div>
                            <div><i class="fas fa-book"></i> Subjects: <span id="profileSubject">Loading...</span></div>
                            <div><i class="fas fa-users"></i> <span id="profileStudents">Loading...</span> Students</div>
                        </div>

                        <div>
                            <div><i class="fas fa-school"></i> <span id="profileSchool">Loading...</span></div>
                            <div><i class="fas fa-map-marker-alt"></i> <span id="profileLocation">Loading...</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="activitiesSection" class="activities">
        <div class="Schedules_null">Loading classes...</div>
    </section>
</div>

<script>
    // 🔹 Load profile data from API
    async function loadUserProfile() {
        try {
            console.log(userId);
            const response = await fetch(`/api/UserAccount/userById?id=${userId}`, {
                headers: {
                    "Authorization": `Bearer ${userToken}`
                }
            });

            if (!response.ok) {
                throw new Error(await response.text());
            }

            var resp = await response.json();
            const data = resp.data;
            console.log("Profile Data:", data);

            // Fill profile info
            document.getElementById("profileDescription").innerText = data.description || "No description provided.";
            document.getElementById("profileImage").src = data.profileImageUrl || "/images/default-avatar.png";
            document.getElementById("profileName").innerText = data.fullName?.toUpperCase() || "No Name";
            document.getElementById("profileTitle").innerText = data.professionalTitle || "No Title";
            document.getElementById("profileSubject").innerText = data.subject || "Not specified";
            document.getElementById("profileStudents").innerText = data.numbersOfStudents > 0 ? data.numbersOfStudents : "No";
            document.getElementById("profileSchool").innerText = data.schoolName || "Unknown School";
            document.getElementById("profileLocation").innerText = data.localGov || "Unknown Location";

            // Social links
            const socialLinks = [];
            if (data.facebookUrl) socialLinks.push(`<a href="${data.facebookUrl}" target="_blank"><i class="fab fa-facebook-f"></i></a>`);
            if (data.tweeterUrl) socialLinks.push(`<a href="${data.tweeterUrl}" target="_blank"><i class="fab fa-twitter"></i></a>`);
            if (data.linkedInUrl) socialLinks.push(`<a href="${data.linkedInUrl}" target="_blank"><i class="fab fa-linkedin-in"></i></a>`);
            if (data.instagramUrl) socialLinks.push(`<a href="${data.instagramUrl}" target="_blank"><i class="fab fa-instagram"></i></a>`);
            document.getElementById("socialLinks").innerHTML = socialLinks.join("");

            // Load schedules
            renderSchedules(data.schedules || []);
        } catch (err) {
            console.error(err);
            toastr.error("Failed to load profile data", "Error");
        }
    }

    // 🔹 Render schedules
    function renderSchedules(schedules) {
        const container = document.getElementById("activitiesSection");
        if (!schedules.length) {
            container.innerHTML = `<div class="Schedules_null">No Available Classes</div>`;
            return;
        }

        const now = new Date();
        let html = `<div class="activity-cards">`;

        schedules.forEach(activity => {
            let statusClass = "";
            let statusText = "";

            if (activity.startDate) {
                const start = new Date(activity.startDate);
                const end = new Date(activity.endDate);

                if (start <= now && end > now) {
                    statusClass = "ongoing";
                    statusText = "Status : Ongoing";
                } else if (start > now && start <= new Date(now.getTime() + 60 * 60000)) {
                    statusClass = "starting";
                    statusText = `Status : Starting in ${Math.floor((start - now) / 60000)} Minutes`;
                } else if (start > now) {
                    statusClass = "not-started";
                    statusText = "Status : Not Started";
                } else {
                    statusClass = "ended";
                    statusText = "Status : Ended";
                }
            }

            html += `
                <div class="activity-card ${statusClass}">
                    <h4>${activity.title}</h4>
                    <p>${activity.focus || "Batch Info"}</p>
                    <p><i class="far fa-clock"></i> ${activity.startDate ? new Date(activity.startDate).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : ""}</p>
                    <p><i class="far fa-calendar-alt"></i> ${activity.startDate ? new Date(activity.startDate).toLocaleDateString() : ""}</p>
                    <span class="status ${statusClass}">${statusText}</span>
                    ${activity.meetingUrl ? `<a href="${activity.meetingUrl}" target="_blank"><button>Join Now</button></a>` : `<button disabled>Link Not Available</button>`}
                </div>
            `;
        });

        html += `</div>`;
        container.innerHTML = html;
    }

    // 🔹 Upload handler
    document.getElementById("uploadTrigger").addEventListener("click", () => {
        document.getElementById("profileImageInput").click();
    });

    document.getElementById("profileImageInput").addEventListener("change", async function () {
        const file = this.files[0];
        if (!file) return;

        if (file.size > 2 * 1024 * 1024) {
            toastr.error("File size must not exceed 2MB.", "Error");
            return;
        }

        const formData = new FormData();
        formData.append("ProfileImage", file);

        try {
            const response = await fetch("/api/UserAccount/upload", {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${userToken}`
                },
                body: formData
            });

            if (response.ok) {
                toastr.success("Image uploaded successfully!", "Success");
                loadUserProfile(); // reload profile
            } else {
                let errorMsg = await response.text();
                toastr.error(errorMsg, "Error");
            }
        } catch (err) {
            console.error(err);
            toastr.error("An error occurred while uploading.", "Error");
        }
    });

    // 🔹 Initialize
    loadUserProfile();
</script>


