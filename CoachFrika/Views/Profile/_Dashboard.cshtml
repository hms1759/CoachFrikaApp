@model userProfileViewModel
@{
    Layout = null;
    ViewBag.Title = "Dashboard";
}
<script>
    (function (){
    const token = '@TempData["Token"]';
    console.log("token");
    console.log(token);
    if (token) {
        localStorage.setItem("authToken", token);
    }

        })();
</script>
<style>
    .profile-card {
        font-family: 'Segoe UI', sans-serif;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #eee;
        background: #fff;
        box-shadow: 0 0 10px rgba(0,0,0,0.05);
        max-width: 100%;
    }

    .profile-banner {
        background: #7ed321;
        padding: 40px 20px;
        color: white;
        position: relative;
    }

    .profile-banner-text {
        max-width: 50%;
        margin: auto;
        text-align: center;
    }

    .banner-camera {
        position: absolute;
        right: 20px;
        top: 20px;
        width: 30px;
    }

    .profile-info {
        display: flex;
        align-items: flex-start;
        padding: 20px;
        gap: 30px;
        flex-wrap: wrap;
    }

    .profile-image {
        position: relative;
        width: 150px;
        height: 150px;
        flex-shrink: 0;
        top: -8rem;
        margin-bottom: -6rem;
    }

        .profile-image img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            border: 6px solid #fff;
            box-shadow: 0 0 6px rgba(0, 0, 0, 0.1);
        }

    .camera-badge {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: #7ed321;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .camera-badge img {
            width: 16px;
        }

    .profile-details {
        flex: 1;
        min-width: 200px;
    }

        .profile-details h3 {
            margin: 0;
            font-size: 22px;
            font-weight: 600;
        }

        .profile-details .title {
            color: #555;
            margin-bottom: 10px;
        }

    .social-links {
        text-align: center;
        margin: 10px 0;
        color: gray;
    }

    .Schedules_null {
        max-width: 100%;
        height: 400px;
        text-align: center;
        justify-content: center;
        margin: 40px;
    }

    .social-links span {
        margin: 10px 0;
        font-family: Inter;
        font-weight: 600;
        font-size: 14px;
        line-height: 22px;
    }

    .social-links a {
        color: gray;
        margin: 10px 5px;
        text-decoration: none;
        font-size: 16px;
    }

    .experience {
        color: #3cb371;
        margin: 10px 0;
        font-size: 16px;
    }

        .experience strong {
            font-size: 20px;
        }

    .meta-info {
        margin-top: 10px;
        font-size: 15px;
        line-height: 1.8;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
    }

        .meta-info i {
            margin-right: 8px;
            color: #3cb371;
        }

    .profile_description {
        font-family: Inter;
        font-weight: 400;
        font-size: 12px;
        line-height: 22px;
        text-align: justify;
    }

    .profile_social-links {
        font-family: Inter;
        font-weight: 400;
        font-size: 14px;
        line-height: 22px;
        text-align: center;
        color: #333;
    }

    .profile_name {
        font-family: Inter;
        font-weight: 600;
        font-size: 24px;
        line-height: 30px;
    }

    /*************************************/
    .activities-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

        .activities-header input {
            padding: 5px 10px;
            border-radius: 20px;
            border: 1px solid #ccc;
            flex-grow: 1;
        }

        .activities-header button {
            padding: 6px 12px;
            background: #6cc24a;
            color: white;
            border: none;
            border-radius: 4px;
            margin-left: 10px;
            flex-shrink: 0;
        }

    /* ============= RESPONSIVENESS ============= */
    @@media (max-width: 768px) {
        .profile-banner-text

    {
        max-width: 80%;
    }

    .profile-info {
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-details {
        text-align: center;
    }

    .meta-info {
        justify-content: center;
    }

    .activities-header {
        flex-direction: column;
        align-items: stretch;
    }

        .activities-header input,
        .activities-header button {
            width: 100%;
            margin-left: 0;
        }

    }

    @@media (max-width: 425px) {
        .profile-image

    {
        width: 110px;
        height: 110px;
        top: -5rem;
        margin-bottom: -3rem;
    }

    .profile-details h3 {
        font-size: 18px;
    }

    .profile_name {
        font-size: 20px;
    }

    .profile-banner-text {
        max-width: 95%;
        font-size: 14px;
    }

    .meta-info {
        font-size: 13px;
        flex-direction: column;
        align-items: center;
        gap: 5px;
    }

    .activities-header input {
        font-size: 14px;
    }

    .activities-header button {
        font-size: 14px;
        padding: 8px;
    }

    }
</style>

<div class="dashboard-container">
    <section>
        <div class="profile-card">
            <!-- Profile Banner -->
            <div class="profile-banner">
                <div class="profile-banner-text">
                    <img src="~/images/profilelogo-removebg-preview.png" alt="logo" />
                    <div class="profile_description">
                        @(Model.Description ?? "No description provided.")
                    </div>
                </div>
                <img src="~/images/photoicon.png" alt="camera" class="banner-camera" />
            </div>

            <!-- Profile Info Section -->
            <div class="profile-info">
                <!-- Profile Image and Socials -->
                <div class="profile-image">
                    <img src="@(Model.ProfileImageUrl ?? "~/images/default-avatar.png")" alt="Profile" />
                    <div class="social-links">
                        <div><span>Follow me on</span></div>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                            {
                                <a href="@Model.FacebookUrl" target="_blank"><i class="fab fa-facebook-f"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.TweeterUrl))
                            {
                                <a href="@Model.TweeterUrl" target="_blank"><i class="fab fa-twitter"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                            {
                                <a href="@Model.LinkedInUrl" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                            {
                                <a href="@Model.InstagramUrl" target="_blank"><i class="fab fa-instagram"></i></a>
                            }
                        </div>
                    </div>
                </div>

                <div class="space"></div>

                <!-- Profile Details -->
                <div class="profile-details">
                    <div class="d-flex meta-info">
                        <div>
                            <div class="profile_topic">
                                <div class="profile_name">@(Model.FullName?.ToUpper() ?? "No Name")</div>
                                <div class="title">@(Model.ProfessionalTitle ?? "No Title")</div>
                            </div>
                            <div class="experience">
                                <strong>3+</strong> <span>Years Of Experience</span>
                            </div>
                        </div>

                        <div>
                            <div><i class="fas fa-book"></i> Subjects: @(Model.Subject ?? "Not specified")</div>
                            <div><i class="fas fa-users"></i> @(Model.NumbersOfStudents > 0 ? Model.NumbersOfStudents.ToString() : "No") Students</div>
                        </div>

                        <div>
                            <div><i class="fas fa-school"></i> @(Model.SchoolName ?? "Unknown School")</div>
                            <div><i class="fas fa-map-marker-alt"></i> @(Model.LocalGov ?? "Unknown Location")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="activities">
          @if (Model.Schedules == null || !Model.Schedules.Any())
        {
        <div class="Schedules_null">
        No Available Classes
        </div>
        }
        else
        {
        <div>

            <div class="activity-cards">
                @foreach (var activity in Model.Schedules)
                {
                    var now = DateTime.Now;
                    string statusClass = "";
                    string statusText = "";

                    if (activity.StartDate.HasValue)
                    {
                        var start = activity.StartDate.Value;

                        if (start <= now && activity.EndDate > now)
                        {
                            statusClass = "ongoing";
                            statusText = "Status : Ongoing";
                        }
                        else if (start > now && start <= now.AddMinutes(60))
                        {
                            statusClass = "starting";
                            statusText = $"Status : Starting in {(int)(start - now).TotalMinutes} Minutes";
                        }
                        else if (start > now)
                        {
                            statusClass = "not-started";
                            statusText = "Status : Not Started";
                        }
                        else
                        {
                            statusClass = "ended";
                            statusText = "Status : Ended";
                        }
                    }

                    <div class="activity-card @statusClass">
                        <h4>@activity.Title</h4>
                        <p>@(activity.Focus?.ToString() ?? "Batch Info")</p>
                        <p><i class="far fa-clock"></i> @activity.StartDate?.ToString("hh:mm tt")</p>
                        <p><i class="far fa-calendar-alt"></i> @activity.StartDate?.ToString("dd MMM yyyy")</p>
                        <span class="status @statusClass">@statusText</span>

                        @if (!string.IsNullOrEmpty(activity.MeetingUrl))
                        {
                            <a href="@activity.MeetingUrl" target="_blank">
                                <button>Join Now</button>
                            </a>
                        }
                        else
                        {
                            <button disabled>Link Not Available</button>
                        }
                    </div>
                }
            </div>
        </div>
        }
    </section>


</div>




