@model userProfileViewModel
@{
    Layout = null;
    ViewBag.Title = "Dashboard";
}
<script>
    const token = '@TempData["Token"]';
    if (token) {
        localStorage.setItem("authToken", token);
    }
</script>
<div class="dashboard-container">
    <section>
        <div class="profile-card">
            <!-- Profile Banner -->
            <div class="profile-banner">
                <div class="profile-banner-text">
                    <img src="~/images/profilelogo-removebg-preview.png" alt="logo" />
                    <div class="profile_description">
                        @(Model.Description ?? "No description provided.")
                    </div>
                </div>
                <img src="~/images/photoicon.png" alt="camera" class="banner-camera" />
            </div>

            <!-- Profile Info Section -->
            <div class="profile-info">
                <!-- Profile Image and Socials -->
                <div class="profile-image">
                    <img src="@(Model.ProfileImageUrl ?? "~/images/default-avatar.png")" alt="Profile" />
                    <div class="social-links">
                        <div><span>Follow me on</span></div>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(Model.FacebookUrl))
                            {
                                <a href="@Model.FacebookUrl" target="_blank"><i class="fab fa-facebook-f"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.TweeterUrl))
                            {
                                <a href="@Model.TweeterUrl" target="_blank"><i class="fab fa-twitter"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                            {
                                <a href="@Model.LinkedInUrl" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                            {
                                <a href="@Model.InstagramUrl" target="_blank"><i class="fab fa-instagram"></i></a>
                            }
                        </div>
                    </div>
                </div>

                <div class="space"></div>

                <!-- Profile Details -->
                <div class="profile-details">
                    <div class="d-flex meta-info">
                        <div>
                            <div class="profile_topic">
                                <div class="profile_name">@(Model.FullName?.ToUpper() ?? "No Name")</div>
                                <div class="title">@(Model.ProfessionalTitle ?? "No Title")</div>
                            </div>
                            <div class="experience">
                                <strong>3+</strong> <span>Years Of Experience</span>
                            </div>
                        </div>

                        <div>
                            <div><i class="fas fa-book"></i> Subjects: @(Model.Subject ?? "Not specified")</div>
                            <div><i class="fas fa-users"></i> @(Model.NumbersOfStudents > 0 ? Model.NumbersOfStudents.ToString() : "No") Students</div>
                        </div>

                        <div>
                            <div><i class="fas fa-school"></i> @(Model.SchoolName ?? "Unknown School")</div>
                            <div><i class="fas fa-map-marker-alt"></i> @(Model.LocalGov ?? "Unknown Location")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="activities">
        @if (Model.Schedules == null || !Model.Schedules.Any())
        {
            <div class="Schedules_null">
                No Available Classes
            </div>
        }
        else
        {
            <div>
                <div class="activities-header">
                    <h3>Activities</h3>
                    <div class="search-bar">
                        <input type="text" placeholder="Search..." />
                        <button><i class="fas fa-external-link-alt"></i> View All</button>
                    </div>
                </div>

                <div class="activity-cards">
                    @foreach (var activity in Model.Schedules)
                    {
                        var now = DateTime.Now;
                        string statusClass = "";
                        string statusText = "";

                        if (activity.StartDate.HasValue)
                        {
                            var start = activity.StartDate.Value;

                            if (start <= now && activity.EndDate > now)
                            {
                                statusClass = "ongoing";
                                statusText = "Status : Ongoing";
                            }
                            else if (start > now && start <= now.AddMinutes(60))
                            {
                                statusClass = "starting";
                                statusText = $"Status : Starting in {(int)(start - now).TotalMinutes} Minutes";
                            }
                            else if (start > now)
                            {
                                statusClass = "not-started";
                                statusText = "Status : Not Started";
                            }
                            else
                            {
                                statusClass = "ended";
                                statusText = "Status : Ended";
                            }
                        }

                        <div class="activity-card @statusClass">
                            <h4>@activity.Title</h4>
                            <p>@(activity.Focus?.ToString() ?? "Batch Info")</p>
                            <p><i class="far fa-clock"></i> @activity.StartDate?.ToString("hh:mm tt")</p>
                            <p><i class="far fa-calendar-alt"></i> @activity.StartDate?.ToString("dd MMM yyyy")</p>
                            <span class="status @statusClass">@statusText</span>

                            @if (!string.IsNullOrEmpty(activity.MeetingLink))
                            {
                                <a href="@activity.MeetingLink" target="_blank">
                                    <button>Join Now</button>
                                </a>
                            }
                            else
                            {
                                <button disabled>Link Not Available</button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </section>


