<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Schedule Page</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Toastr CSS + JS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        toastr.options = {
            "closeButton": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>
</head>
<body>

    <div class="schedule-container">
        <!-- Top Bar -->
        <div class="schedule-top-bar">
            <div class="schedule-title">Schedule</div>
            <div class="schedule-right-section">
                <input type="text" id="searchTitle" placeholder="Title..." class="schedule-search-bar" />
                <input type="datetime-local" id="searchDate" />
                <button class="schedule-create-btn" onclick="searchSchedules()">Search</button>
                <button class="schedule-create-btn" id="createScheduleBtn" onclick="openScheduleModal()">+ Create Schedule</button>
            </div>
        </div>
        <br />
        <!-- Tabs -->
        <ul class="schedule-tabs">
            <li class="schedule-tab active" data-status="comingsoon">Not Started</li>
            <li class="schedule-tab" data-status="ongoing">Ongoing Classes</li>
            <li class="schedule-tab" data-status="past">Completed Classes</li>
            <li class="schedule-tab" data-status="missed">Missed Classes</li>
        </ul>

        <!-- Tab Content -->
        <div id="tab-content" class="activity-cards"></div>
    </div>

    <!-- Modal -->
    <div class="schedule-dd-modal-overlay" id="scheduleModal">
        <div class="schedule-modal">
            <div style="display: flex; justify-content: space-between; align-items: center; width: 100%">
                <h3>Create New Schedule</h3>
                <button class="schedule-modal-close-btn" type="button" onclick="closeScheduleModal()">x</button>
            </div>
            <form id="scheduleForm">
                <input type="text" name="Title" placeholder="Title" required />
                <select name="Focus" required>
                    <option value="">Select Focus</option>
                    <option value="0">Intentional</option>
                    <option value="1">Phenomenal</option>
                    <option value="2">Transformational</option>
                </select>
                <input type="datetime-local" name="Scheduled" required />
                <select name="DurationType" required>
                    <option value="">Select Duration Type</option>
                    <option value="0">Minutes</option>
                    <option value="1">Hours</option>
                </select>
                <input type="number" name="Duration" placeholder="Duration" required />
                <input type="url" name="MeetingUrl" placeholder="Meeting URL" />
                <button type="submit">Submit</button>
            </form>
        </div>
    </div>

    <script>
                (function () {
        const usertoken = @Html.Raw(Context.Session.GetString("Token") ?? "");

        const role = getRoleFromToken();

        function getRoleFromToken() {
            if (!usertoken) return null;
            try {
                const payload = JSON.parse(atob(usertoken.split('.')[1]));
                return payload["http://schemas.microsoft.com/ws/2008/06/identity/claims/role"] || null;
            } catch (err) {
                console.error("Token decode error:", err);
                return null;
            }
        }

        function openScheduleModal() {
            $("#scheduleModal").fadeIn();
        }

        function closeScheduleModal() {
            $("#scheduleModal").fadeOut();
        }
                function dontShoScheduleModal() {
            document.getElementById("scheduleModal").style.display = "none";
        }
        function loadSchedules(status) {
        dontShoScheduleModal()
            let url = "";
            if (role === "Coach") {
                url = `/api/Scheduled/GetCoachSchedule?status=${status}&PageSize=20&PageNumber=1`;
            } else if (role === "Teacher") {
                url = `/api/Teachers/GetMySchedule?status=${status}&PageSize=20&PageNumber=1`;
            } else {
                toastr.warning("Unknown role or not authenticated.");
                return;
            }

            $.ajax({
                url: url,
                headers: {
                    "Authorization": `Bearer ${usertoken}`
                },
                success: function (res) {
                    const container = $("#tab-content").empty();
                    if (!res.data || res.data.length === 0) {
                        container.html("<p>No schedules found.</p>");
                        return;
                    }

                    const now = new Date();
                    res.data.forEach(item => {
                        const start = new Date(item.startDate || item.scheduled);
                        const end = item.endDate ? new Date(item.endDate) : null;
                        const timeStr = start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        const dateStr = start.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });

                        let statusText = "Not Started";
                        let statusClass = "not-started";
                        const diffInMinutes = (start - now) / 60000;

                        if (diffInMinutes <= 60 && diffInMinutes > 0) {
                            statusText = "Starting in 60 Minutes";
                            statusClass = "starting";
                        } else if (diffInMinutes <= 0 && (!end || end > now)) {
                            statusText = "Ongoing";
                            statusClass = "ongoing";
                        }

                        container.append(`
                            <div class="activity-card ${statusClass}">
                                <h4>${item.title}</h4>
                                <p>${item.focus || 'Batch 1st Cohort'}</p>
                                <p><i class="far fa-clock"></i> ${timeStr}</p>
                                <p><i class="far fa-calendar-alt"></i> ${dateStr}</p>
                                <span class="status ${statusClass}">Status : ${statusText}</span>
                                <a href="${item.meetingUrl}" target="_blank"><button>Join Now</button></a>
                            </div>
                        `);
                    });
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.message || xhr.responseText || "Error loading schedules.";
                    toastr.error(msg);
                }
            });
        }

        function searchSchedules() {
            const title = $('#searchTitle').val();
            const scheduled = $('#searchDate').val();
            const status = $('.schedule-tab.active').data("status");

            let url = "";
            if (role === "Coach") {
                url = `/api/Scheduled/GetCoachSchedule?Title=${title}&Scheduled=${scheduled}&status=${status}&PageSize=20&PageNumber=1`;
            } else if (role === "Teacher") {
                url = `/api/Teachers/GetMySchedule?Title=${title}&Scheduled=${scheduled}&status=${status}&PageSize=20&PageNumber=1`;
            } else {
                toastr.warning("Unknown role or not authenticated.");
                return;
            }

            $.ajax({
                url: url,
                headers: {
                    "Authorization": `Bearer ${usertoken}`
                },
                success: function (res) {
                    const container = $("#tab-content").empty();
                    if (!res.data || res.data.length === 0) {
                        container.html("<p>No schedules found.</p>");
                        return;
                    }

                    res.data.forEach(item => {
                        const start = new Date(item.scheduled || item.startDate);
                        const timeStr = start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        const dateStr = start.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' });

                        const now = new Date();
                        let statusText = "Not Started";
                        let statusClass = "not-started";
                        const diffInMinutes = (start - now) / 60000;

                        if (diffInMinutes <= 60 && diffInMinutes > 0) {
                            statusText = "Starting in 60 Minutes";
                            statusClass = "starting";
                        } else if (diffInMinutes <= 0 && (!item.endDate || new Date(item.endDate) > now)) {
                            statusText = "Ongoing";
                            statusClass = "ongoing";
                        }

                        container.append(`
                            <div class="activity-card ${statusClass}">
                                <h4>${item.title}</h4>
                                <p>${item.focus || 'Batch 1st Cohort'}</p>
                                <p><i class="far fa-clock"></i> ${timeStr}</p>
                                <p><i class="far fa-calendar-alt"></i> ${dateStr}</p>
                                <span class="status ${statusClass}">Status : ${statusText}</span>
                                <a href="${item.meetingUrl}" target="_blank"><button>Join Now</button></a>
                            </div>
                        `);
                    });
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.message || xhr.responseText || "Search failed.";
                    toastr.error(msg);
                }
            });
        }

        $("#scheduleForm").on("submit", function (e) {
            e.preventDefault();
            const formData = Object.fromEntries(new FormData(this).entries());
            formData.Focus = parseInt(formData.Focus);
            formData.DurationType = parseInt(formData.DurationType);
            formData.Duration = parseInt(formData.Duration);

            const url = role === "Coach" ? "/api/Scheduled/CreateSchedule" : "";

            if (!url) {
                toastr.warning("Only Coach can create schedules.");
                return;
            }

            $.ajax({
                url: url,
                method: "POST",
                contentType: "application/json",
                headers: { "Authorization": `Bearer ${usertoken}` },
                data: JSON.stringify(formData),
                success: function () {
                    toastr.success("Schedule created successfully.");
                    closeScheduleModal();
                    loadSchedules("comingsoon");
                },
                error: function (xhr) {
                    const msg = xhr.responseJSON?.message || xhr.responseText || "Error creating schedule.";
                    toastr.error(msg);
                }
            });
        });

        $(".schedule-tab").on("click", function () {
            $(".schedule-tab").removeClass("active");
            $(this).addClass("active");
            const status = $(this).data("status");
            loadSchedules(status);
        });

        if (role !== "Coach") {
            $("#createScheduleBtn").hide();
        }

        closeScheduleModal()
        loadSchedules("comingsoon");
        })();
    </script>

</body>
</html>
