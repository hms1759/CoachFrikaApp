<!-- ================== LIBRARIES ================== -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- Include Select2 + Chart.js -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* ====== Modal Styles ====== */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        width: 400px;
        max-width: 95%;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        animation: fadeIn 0.3s ease-in-out;
    }

        .modal-content h3 {
            margin-bottom: 15px;
            font-size: 20px;
            font-weight: bold;
        }

        .modal-content input {
            width: 100%;
            padding: 10px;
            margin-bottom: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        .modal-content button {
            padding: 10px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 8px;
        }

            .modal-content button[type="submit"] {
                background: green;
                color: white;
            }

            .modal-content button[type="button"] {
                background: #ccc;
            }

    .subject-field {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ====== Table Styles ====== */
    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 20px;
        font-size: 14px;
    }

    thead {
        background: green;
        color: white;
    }

        thead th {
            text-align: left;
            padding: 12px;
            font-weight: bold;
        }

    tbody tr {
        transition: background 0.2s ease;
    }

        tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        tbody tr:hover {
            background: #eef5ff;
        }

    tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid #ddd;
    }

    /* ====== Pagination ====== */
    .teacher-pagination {
        margin-top: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

        .teacher-pagination button {
            background: green;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }

            .teacher-pagination button:hover {
                background: darkgreen;
            }

        .teacher-pagination span {
            font-weight: bold;
        }

    /* Container for spacing */
    .subject-dropdown-container {
        margin: 15px 0;
        display: flex;
        flex-direction: column;
    }

    /* Label styling */
    .subject-label {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 6px;
        color: #333;
    }

    /* Styled dropdown */
    .subject-dropdown {
        width: 250px;
        padding: 10px 14px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 8px;
        background-color: #fff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

        .subject-dropdown:hover {
            border-color: #007bff;
        }

        .subject-dropdown:focus {
            border-color: #007bff;
            outline: none;
            box-shadow: 0 0 6px rgba(0,123,255,0.4);
        }

    .student-top-bar {
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        margin-bottom: 3rem;
    }

    .subjectDropdown {
        height: 30px;
    }

    .chart-container {
        width: 80%; /* Chart takes 80% of parent width */
        margin: 20px auto; /* Centers it horizontally */
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #studentChart {
        width: 100% !important; /* Make canvas responsive */
        height: auto !important;
    }
</style>

<div class="space"></div>
<span style="font-weight: bold; font-size: 18px;">Student and I</span>
<div class="space"></div>

<!-- Top Bar -->
<div class="student-top-bar">
    <div>
        <select id="subjectDropdown" class="subjectDropdown">
            <option value="">-- Select Subject --</option>
        </select>
        <select id="studentDropdown" class="subjectDropdown">
            <option value="">-- Select Student --</option>
        </select>
        <input type="text" id="classSearchInput" class="teacher-search-input" placeholder="Search by Class..." />
        <button class="teacher-view-all-btn" onclick="handleStudentScoreSearch()">Search Student</button>
        <button class="teacher-view-all-btn" onclick="openCreateSubjectModal()">+ Add Subject</button>
        <button class="teacher-view-all-btn" onclick="openCreateStudentModal()">+ Add Student</button>
    </div>
</div>

<!-- Chart -->
<div class="chart-container">
    <canvas id="studentChart"></canvas>
</div>

<!-- Student Table -->
<table id="studentScoreTable">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Parent Number</th>
            <th>Class</th>
            <th>Subject</th>
            <th>1st CA</th>
            <th>2nd CA</th>
            <th>Exam</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody id="scoreSheetTableBody"></tbody>
</table>

<!-- Pagination -->
<div class="teacher-pagination" id="studentPagination">
    <button onclick="studentGoToPreviousPage()">Previous</button>
    <span id="studentPageInfo">Page 1</span>
    <button onclick="studentGoToNextPage()">Next</button>
</div>

<!-- ================= MODALS ================= -->
<div id="createSubjectModal" class="modal">
    <div class="modal-content">
        <h3>Add Subjects</h3>
        <form id="createSubjectForm">
            <div id="subjectFieldsWrapper">
                <div class="subject-field">
                    <input type="text" name="Subject" placeholder="Subject Name" required />
                    <input type="text" name="SubjectCode" placeholder="Subject Code" required />
                </div>
            </div>
            <button type="button" onclick="addMoreSubjectField()">+ Add More</button>
            <br /><br />
            <button type="submit">Submit</button>
            <button type="button" onclick="closeCreateSubjectModal()">Cancel</button>
        </form>
    </div>
</div>

<div id="createStudentModal" class="modal">
    <div class="modal-content">
        <h3>Add Student</h3>
        <form id="createStudentForm">
            <input type="number" name="ClassId" placeholder="ClassId" required />
            <input type="number" name="ClassNumber" placeholder="Class Number" required />
            <input type="text" name="Name" placeholder="Student Name" required />
            <input type="text" name="Address" placeholder="Address" />
            <input type="text" name="ParentName" placeholder="Parent Name" required />
            <input type="text" name="Class" placeholder="Class" required />
            <input type="text" name="ParentPhoneNumber" placeholder="Parent Phone Number" required />
            <br /><br />
            <button type="submit">Submit</button>
            <button type="button" onclick="closeCreateStudentModal()">Cancel</button>
        </form>
    </div>
</div>

<script>
    // ================= GLOBAL STATE =================
    var studentPageNumber = 1;
    var studentPageSize = 10;
     var classSearchTerm = '';
    var selectedSubjectId = '';
    var selectedStudentId = '';
    var studentChart;
    var selectedClassId = '';
   var isAllClass = false;
    var selectedSubjectName = '';

        // Check if any has a value
    if (
        (selectedStudentId && selectedStudentId.trim() !== '') ||
        (selectedSubjectId && selectedSubjectId.trim() !== '')
    ) {
        isAllClass = true;
    }

    // ================= STUDENTS =================
    function loadStudentsDropdown() {
        fetch("/api/Students/GetAllStudents", {
            headers: { "Authorization": `Bearer ${userToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const dropdown = document.getElementById("studentDropdown");
            dropdown.innerHTML = `<option value="">-- Select Student --</option>`;

            const list = data.data || data;
            if (Array.isArray(list)) {
                list.forEach(std => {
                    const opt = document.createElement("option");
                    opt.value = std.id;
                    opt.textContent = std.name;
                    dropdown.appendChild(opt);
                });
            } else {
                toastr.warning("No Student found from API.");
            }
        })
        .catch(err => {
            console.error("Error loading Students:", err);
            toastr.error("Error loading Students.");
        });
    }

    document.getElementById("studentDropdown").addEventListener("change", function () {
        selectedStudentId = this.value;
        selectedSubjectName = this.options[this.selectedIndex].text;
        studentPageNumber = 1;
    });

    // ================= SUBJECTS =================
    function loadSubjectsDropdown() {
        fetch("/api/Teachers/GetSubject", {
            headers: { "Authorization": `Bearer ${userToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const dropdown = document.getElementById("subjectDropdown");
            dropdown.innerHTML = `<option value="">-- Select Subject --</option>`;

            const list = data.data || data;
            if (Array.isArray(list)) {
                list.forEach(sub => {
                    const opt = document.createElement("option");
                    opt.value = sub.id || sub.subjectId;
                    opt.textContent = sub.subjectName || sub.name;
                    dropdown.appendChild(opt);
                });
            } else {
                toastr.warning("No subjects found from API.");
            }
        })
        .catch(err => {
            console.error("Error loading subjects:", err);
            toastr.error("Error loading subjects.");
        });
    }

    document.getElementById("subjectDropdown").addEventListener("change", function () {
        selectedSubjectId = this.value;
        studentPageNumber = 1;
    });

    // ================= STUDENTSCORES =================
    function handleStudentScoreSearch() {
        classSearchTerm = document.getElementById("classSearchInput").value.trim();
        studentPageNumber = 1;
        loadStudentsScores();
    }

    function loadStudentsScores() {
           const url = `/api/Students/GetAllStudentsScores?SubjectId=${selectedSubjectId || ''}&StudentId=${encodeURIComponent(classSearchTerm)}&ClassId=${selectedClassId || ''}&StudentId=${encodeURIComponent(selectedStudentId)}&isAll=${isAllClass}&Pagesize=${studentPageSize}&PageNumber=${studentPageNumber}`;
        fetch(url, {
            headers: { "Authorization": `Bearer ${userToken}` }
        })
        .then(res => res.json())
        .then(data => {
            const tableBody = document.getElementById("scoreSheetTableBody");
            tableBody.innerHTML = "";

            if (!data?.data?.score?.length) {
                tableBody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:15px;">No students found.</td></tr>`;
                updateStudentChart([]);
                return;
            }

            data.data.score.forEach(stu => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${stu.studentName || ""}</td>
                    <td>${stu.parentNumber || ""}</td>
                    <td>${stu.className || ""}</td>
                    <td>${stu.subject || ""}</td>
                    <td>${stu.firstCA ?? ""}</td>
                    <td>${stu.secondCA ?? ""}</td>
                    <td>${stu.exam ?? ""}</td>
                    <td><strong>${stu.total ?? ""}</strong></td>
                `;
                tableBody.appendChild(row);
            });

            if (isAllClass) {
                updateAllStudentChart(data.data.score);
            } else {
                updateStudentChart(data.data.score);
            }

            document.getElementById("studentPageInfo").textContent = `Page ${studentPageNumber}`;
        })
        .catch(err => {
            console.error("Error fetching students:", err);
            toastr.error("Error loading students.");
        });
    }

    function studentGoToNextPage() {
        studentPageNumber++;
        loadStudentsScores();
    }

    function studentGoToPreviousPage() {
        if (studentPageNumber > 1) {
            studentPageNumber--;
            loadStudentsScores();
        }
    }

    // ================= CHART =================
   

    function updateStudentChart(students = []) {
        if (!Array.isArray(students)) students = [];
        const ctx = document.getElementById("studentChart").getContext("2d");
        const labels = students.map(s => s.studentName || "");
        const values = students.map(s => s.total || 0);

        if (studentChart) studentChart.destroy();

        studentChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                     label: selectedSubjectName || "Class Member", // ✅ Subject name or default
                    data: values,
                    backgroundColor: "green"
                }]
            },
            options: {
                scales: {
                    y: {
                        min: 10,
                        max: 100,
                        ticks: { stepSize: 10 }
                    }
                }
            }
        });
    }

    // ================= INIT =================
    loadSubjectsDropdown();
    loadStudentsDropdown();
    loadStudentsScores();
</script>
