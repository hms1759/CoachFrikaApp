<!-- ================== LIBRARIES ================== -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<!-- Include Select2 + Chart.js -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* ====== Modal Styles ====== */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0, 0, 0, 0.6);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background: #fff;
        padding: 25px;
        border-radius: 12px;
        width: 400px;
        max-width: 95%;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        animation: fadeIn 0.3s ease-in-out;
    }

        .modal-content h3 {
            margin-bottom: 15px;
            font-size: 20px;
            font-weight: bold;
        }

        .modal-content input, .modal-content select {
            width: 100%;
            padding: 10px;
            margin-bottom: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        .modal-content button {
            padding: 10px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 8px;
        }

            .modal-content button[type="submit"] {
                background: green;
                color: white;
            }

            .modal-content button[type="button"] {
                background: #ccc;
            }

    .subject-field {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ====== Table Styles ====== */
    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
        margin-top: 20px;
        font-size: 14px;
    }

    thead {
        background: green;
        color: white;
    }

        thead th {
            text-align: left;
            padding: 12px;
            font-weight: bold;
        }

    tbody tr {
        transition: background 0.2s ease;
    }

        tbody tr:nth-child(even) {
            background: #f9f9f9;
        }

        tbody tr:hover {
            background: #eef5ff;
        }

    tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid #ddd;
    }

    /* ====== Pagination ====== */
    .teacher-pagination {
        margin-top: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
    }

        .teacher-pagination button {
            background: green;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

            .teacher-pagination button:hover {
                background: darkgreen;
            }

        .teacher-pagination span {
            font-weight: bold;
        }

    .student-top-bar {
        display: flex;
        justify-content: space-evenly;
        align-items: center;
        margin-bottom: 3rem;
        gap: 8px;
        flex-wrap: wrap;
    }

    .subjectDropdown {
        height: 30px;
    }

    .chart-container {
        width: 80%;
        margin: 20px auto;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #studentChart {
        width: 100% !important;
        height: auto !important;
    }

    /* ===== Editable mode ===== */
    .edit-buttons {
        margin-top: 15px;
        text-align: right;
    }

        .edit-buttons button {
            padding: 8px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-left: 10px;
        }

    #editScoresBtn {
        background: orange;
        color: white;
        display: none;
    }

    #saveScoresBtn {
        background: blue;
        color: white;
        display: none;
    }

    #cancelEditBtn {
        background: red;
        color: white;
        display: none;
    }
</style>

<div class="space"></div>
<span style="font-weight: bold; font-size: 18px;">Student and I</span>
<div class="space"></div>

<!-- Top Bar -->
<div class="student-top-bar">
    <div>
        <select id="subjectDropdown" class="subjectDropdown">
            <option value="">-- Select Subject --</option>
        </select>
        <select id="studentDropdown" class="subjectDropdown">
            <option value="">-- Select Student --</option>
        </select>
        <!-- ✅ Replaced text input with dropdown -->
        <select id="classFilterDropdown" class="subjectDropdown">
            <option value="">-- Select Class --</option>
        </select>
        <button class="teacher-view-all-btn" onclick="handleStudentScoreSearch()">Search Student</button>
        <button class="teacher-view-all-btn" onclick="openCreateSubjectModal()">+ Add Subject</button>
        <button class="teacher-view-all-btn" onclick="openCreateStudentModal()">+ Add Student</button>
    </div>
</div>

<div class="space"></div>
<!-- Chart -->
<div class="chart-container">
    <canvas id="studentChart"></canvas>
</div>

<div class="space"></div>
<div class="space"></div>
<!-- Editable Controls -->
<div class="edit-buttons">
    <button id="editScoresBtn" onclick="enableScoreEditing()">Edit Scores</button>
    <button id="saveScoresBtn" onclick="saveEditedScores()">Save All Scores</button>
    <button id="cancelEditBtn" onclick="cancelScoreEditing()">Cancel</button>
</div>

<div class="space"></div>
<div class="space"></div>
<!-- Student Table -->
<table id="studentScoreTable">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>Parent Number</th>
            <th>Class</th>
            <th>Subject</th>
            <th>1st CA</th>
            <th>2nd CA</th>
            <th>Exam</th>
            <th>Total</th>
            <th>No of Course</th>
            <th>Cumulative Total</th>
        </tr>
    </thead>
    <tbody id="scoreSheetTableBody"></tbody>
</table>

<div class="space"></div>
<div class="space"></div>
<!-- Pagination -->
<div class="teacher-pagination" id="studentPagination">
    <button onclick="studentGoToPreviousPage()">Previous</button>
    <span id="studentPageInfo">Page 1</span>
    <button onclick="studentGoToNextPage()">Next</button>
</div>

<div class="space"></div>
<div class="space"></div>
<!-- ================= MODALS ================= -->
<div id="createSubjectModal" class="modal">
    <div class="modal-content">
        <h3>Add Subjects</h3>
        <form id="createSubjectForm">
            <div id="subjectFieldsWrapper">
                <!-- First Subject Dropdown -->
                <div class="subject-field">
                    <select class="subjectDropdown" name="SubjectId[]" required>
                        <option value="">-- Select Subject --</option>
                    </select>
                </div>
            </div>
            <button type="button" id="addMoreSubjectBtn">+ Add More Subject</button>
            <br><br>
            <button type="submit">Save</button>
        </form>
    </div>
</div>

<div id="createStudentModal" class="modal">
    <div class="modal-content">
        <h3>Add Student</h3>
        <form id="createStudentForm">
            <select id="classDropdown" name="ClassId" required>
                <option value="">-- Select Class --</option>
            </select>
            <input type="number" name="ClassNumber" placeholder="Class Number" required />
            <input type="text" name="Name" placeholder="Student Name" required />
            <input type="text" name="Address" placeholder="Address" />
            <input type="text" name="ParentName" placeholder="Parent Name" required />
            <input type="text" name="ParentPhoneNumber" placeholder="Parent Phone Number" required />
            <br /><br />
            <button type="submit">Submit</button>
            <button type="button" onclick="closeCreateStudentModal()">Cancel</button>
        </form>
    </div>
</div>

<script>
    /* ================== FULL SCRIPT ================== */

    /* --------- ENUMS --------- */
    var ClassRoomEnum = {
        1: "Primary 1", 2: "Primary 2", 3: "Primary 3", 4: "Primary 4",
        5: "Primary 5", 6: "Primary 6", 7: "Junior Secondary School 1",
        8: "Junior Secondary School 2", 9: "Junior Secondary School 3",
        10: "Senior Secondary School 1", 11: "Senior Secondary School 2",
        12: "Senior Secondary School 3"
    };

    var SchoolSubjectEnum = {
      1:"EnglishLanguage",2:"Mathematics",3:"BasicScience",4:"BasicTechnology",
      5:"CivicEducation",6:"SocialStudies",7:"AgriculturalScience",8:"CulturalAndCreativeArts",
      9:"ChristianReligiousStudies",10:"IslamicReligiousStudies",11:"PhysicalHealthEducation",
      12:"ComputerStudies",13:"VerbalReasoning",14:"QuantitativeReasoning",15:"MoralInstruction",
      16:"Handwriting",17:"HomeEconomics",18:"EnglishLanguageSecondary",19:"MathematicsSecondary",
      20:"CivicEducationSecondary",21:"Economics",22:"Biology",23:"Chemistry",24:"Physics",25:"Geography",
      26:"Government",27:"LiteratureInEnglish",28:"AgriculturalScienceSecondary",29:"TechnicalDrawing",
      30:"FurtherMathematics",31:"Commerce",32:"FinancialAccounting",33:"FoodAndNutrition",34:"HomeManagement",
      35:"Music",36:"FineArts",37:"Woodwork",38:"Metalwork",39:"Electronics",40:"AutoMechanics",
      41:"BuildingConstruction",42:"French",43:"Arabic",44:"Yoruba",45:"Hausa",46:"Igbo",
      47:"PhysicalAndHealthEducationSecondary",48:"ComputerScience",49:"ChristianReligiousStudiesSecondary",
      50:"IslamicReligiousStudiesSecondary"
    };

    /* --------- STATE --------- */
    var studentPageNumber = 1, studentPageSize = 10;
    var selectedSubjectId = '', selectedStudentId = '', selectedClassId = '';
    var isAllClass = false, isOnlyStudent = false;
    var selectedSubjectName = '';
    var studentChart = null;
    var isEditingScores = false;
    var lastLoadedScores = [];

    /* --------- HELPERS --------- */
    function updateIsAllClass() {
        isAllClass = (!selectedStudentId && !selectedClassId && !selectedSubjectId);
        isOnlyStudent = (selectedStudentId && !selectedClassId && !selectedSubjectId);
        // Show/hide edit button depending on condition (only show when single-student mode)
        document.getElementById("editScoresBtn").style.display = isOnlyStudent ? "inline-block" : "none";

        // If we left edit mode because filters changed, cancel editing
        if (!isOnlyStudent && isEditingScores) {
            cancelScoreEditing();
        }
    }

    /* Populate main class dropdown (for create student modal) */
    function populateClassDropdown() {
      const classDropdown = document.getElementById("classDropdown");
      classDropdown.innerHTML = `<option value="">-- Select Class --</option>`;
      for (const [id, name] of Object.entries(ClassRoomEnum)) {
        const opt = document.createElement("option");
        opt.value = id; opt.textContent = name;
        classDropdown.appendChild(opt);
      }
      updateIsAllClass();
    }

    /* Populate the class filter dropdown (top bar) */
    function populateClassFilterDropdown() {
      const $dropdown = $("#classFilterDropdown");
      $dropdown.empty().append('<option value="">-- Select Class --</option>');
      for (const [id, name] of Object.entries(ClassRoomEnum)) {
        $dropdown.append(`<option value="${id}">${name}</option>`);
      }
      updateIsAllClass();
    }

    /* Populate subject options into a jQuery select element (works for modal fields too) */
    function populateSubjectDropdown($dropdown) {
        // accept either jQuery object or selector or DOM element
        var $jq = $($dropdown);
        $jq.empty().append('<option value="">-- Select Subject --</option>');
        for (const key in SchoolSubjectEnum) {
            $jq.append(`<option value="${key}">${SchoolSubjectEnum[key]}</option>`);
        }
        updateIsAllClass();
    }

    /* --------- DYNAMIC SUBJECT FIELDS (modal) --------- */
    $("#addMoreSubjectBtn").on("click", function () {
        const newField = $(`
            <div class="subject-field">
                <select class="subjectDropdown" name="SubjectId[]" required></select>
                <button type="button" class="removeSubjectBtn">Remove</button>
            </div>
        `);
        populateSubjectDropdown(newField.find(".subjectDropdown"));
        $("#subjectFieldsWrapper").append(newField);
    });

    $(document).on("click", ".removeSubjectBtn", function () {
        $(this).closest(".subject-field").remove();
    });

    /* --------- LOAD SUBJECTS & STUDENTS DROPDOWNS FROM API --------- */
    function loadSubjectsDropdown(){
      fetch("/api/Teachers/GetSubject", { headers: { Authorization: `Bearer ${userToken}` } })
        .then(res => res.json())
        .then(data => {
          const dropdown = document.getElementById("subjectDropdown");
          dropdown.innerHTML = `<option value="">-- Select Subject --</option>`;
          const list = data.data || data;
          if (Array.isArray(list)) {
            list.forEach(sub => {
              const opt = document.createElement("option");
              opt.value = sub.subjectId ?? sub.id ?? "";
              opt.textContent = sub.subject ?? sub.name ?? "";
              dropdown.appendChild(opt);
            });
          } else {
            toastr.warning("No subjects found.");
          }
        })
        .catch(err => { console.error(err); toastr.error("Error loading subjects."); });
    }

    function loadStudentsDropdown(){
      fetch("/api/Students/GetAllStudents", { headers: { Authorization: `Bearer ${userToken}` } })
        .then(res => res.json())
        .then(data => {
          const dropdown = document.getElementById("studentDropdown");
          dropdown.innerHTML = `<option value="">-- Select Student --</option>`;
          const list = (data.data && Array.isArray(data.data)) ? data.data : (Array.isArray(data) ? data : []);
          if (Array.isArray(list)) {
            list.forEach(std => {
              const opt = document.createElement("option");
              opt.value = std.id ?? std.studentId ?? "";
              opt.textContent = std.name ?? std.studentName ?? "";
              dropdown.appendChild(opt);
            });
          } else {
            toastr.warning("No Student found.");
          }
        })
        .catch(err => { console.error(err); toastr.error("Error loading Students."); });
    }

    /* --------- EVENT BINDINGS FOR FILTER CONTROLS --------- */
    document.getElementById("studentDropdown").addEventListener("change", function(){
      selectedStudentId = this.value;
      studentPageNumber = 1;
      updateIsAllClass();
    });
    document.getElementById("subjectDropdown").addEventListener("change", function(){
      selectedSubjectId = this.value;
      selectedSubjectName = this.options[this.selectedIndex]?.text || '';
      studentPageNumber = 1;
      updateIsAllClass();
    });
    $("#classFilterDropdown").on("change", function(){
      selectedClassId = this.value;
      studentPageNumber = 1;
      updateIsAllClass();
    });

    /* --------- SCORES: load, render, pages --------- */
    function handleStudentScoreSearch(){
      studentPageNumber = 1; loadStudentsScores();
    }

    function loadStudentsScores(){
      const url = `/api/Students/GetAllStudentsScores?SubjectId=${selectedSubjectId||''}&ClassId=${selectedClassId||''}&StudentId=${encodeURIComponent(selectedStudentId||'')}&isAll=${isAllClass}&Pagesize=${studentPageSize}&PageNumber=${studentPageNumber}`;
      fetch(url, { headers: { Authorization: `Bearer ${userToken}` } })
        .then(res => res.json())
        .then(data => {
          const tableBody = document.getElementById("scoreSheetTableBody");
          tableBody.innerHTML = "";
          const scores = data?.data?.score ?? data?.score ?? [];
          if (!Array.isArray(scores) || scores.length === 0) {
            tableBody.innerHTML = `<tr><td colspan="10" style="text-align:center; padding:15px;">No students found.</td></tr>`;
            updateStudentChart([]);
            return;
          }
          lastLoadedScores = scores;
          scores.forEach(stu => {
            const studentId = stu.studentId ?? stu.id ?? "";
            const StudentScoreId = stu.id ?? "";
            const firstCA = (stu.firstCA !== undefined && stu.firstCA !== null) ? stu.firstCA : "";
            const secondCA = (stu.secondCA !== undefined && stu.secondCA !== null) ? stu.secondCA : "";
            const exam = (stu.exam !== undefined && stu.exam !== null) ? stu.exam : "";
            const total = (stu.total !== undefined && stu.total !== null) ? stu.total : ( (parseInt(firstCA||0,10) + parseInt(secondCA||0,10) + parseInt(exam||0,10)) || "" );

            const row = document.createElement("tr");
            row.setAttribute("data-student-id", studentId);
            row.setAttribute("data-StudentScore-id", StudentScoreId);
            row.innerHTML = `
                <td class="col-studentName">${stu.studentName ?? stu.subject ?? ""}</td>
                <td class="col-parentNumber">${stu.parentNumber ?? ""}</td>
                <td class="col-className">${stu.className ?? ""}</td>
                <td class="col-subject">${stu.subject ?? ""}</td>
                <td class="score-cell" data-field="firstCA">${firstCA}</td>
                <td class="score-cell" data-field="secondCA">${secondCA}</td>
                <td class="score-cell" data-field="exam">${exam}</td>
                <td class="col-total"><strong>${total}</strong></td>
                <td class="col-noOfCourse"><strong>${stu.noOfCourse ?? ""}</strong></td>
                <td class="col-cummulativeTotal"><strong>${stu.cummulativeTotal ?? ""}</strong></td>
            `;
            tableBody.appendChild(row);
          });
          updateStudentChart(scores);
          document.getElementById("studentPageInfo").textContent = `Page ${studentPageNumber}`;
        })
        .catch(err => { console.error(err); toastr.error("Error loading students."); });
    }

    function studentGoToNextPage(){ studentPageNumber++; loadStudentsScores(); }
    function studentGoToPreviousPage(){ if (studentPageNumber > 1) { studentPageNumber--; loadStudentsScores(); } }

    /* --------- CHART --------- */
    function updateStudentChart(students=[]){
      if (!Array.isArray(students)) students = [];
      const ctx = document.getElementById("studentChart").getContext("2d");
      let labels = [];
      if (!isOnlyStudent) labels = students.map(s => s.studentName || "");
      else labels = students.map(s => s.subject || "");
      const values = students.map(s => (s.cummulativeTotal ?? s.total) ? Number(s.cummulativeTotal ?? s.total) : 0);
      if (studentChart) studentChart.destroy();
      studentChart = new Chart(ctx, {
        type: 'bar',
        data: { labels, datasets: [{ label: selectedSubjectName || "Class Member", data: values, backgroundColor: "green" }] },
        options: { scales: { y: { min: 0, max: 100, ticks: { stepSize: 10 } } } }
      });
    }

    /* --------- MODAL CONTROLS --------- */
    function openCreateSubjectModal(){ document.getElementById("createSubjectModal").style.display = "flex"; }
    function closeCreateSubjectModal(){ document.getElementById("createSubjectModal").style.display = "none"; }
    function openCreateStudentModal(){ document.getElementById("createStudentModal").style.display = "flex"; }
    function closeCreateStudentModal(){ document.getElementById("createStudentModal").style.display = "none"; }

    window.onclick = function(event){
      if (event.target === document.getElementById("createSubjectModal")) closeCreateSubjectModal();
      if (event.target === document.getElementById("createStudentModal")) closeCreateStudentModal();
    };

    /* --------- FORM SUBMITS (Subjects + Students) --------- */
    document.getElementById("createSubjectForm").addEventListener("submit", function (e) {
        e.preventDefault();
        const subjects = [];
        document.querySelectorAll("#subjectFieldsWrapper .subjectDropdown").forEach(select => {
            const id = parseInt(select.value, 10);
            const name = select.options[select.selectedIndex]?.text || "";
            if (id && name) subjects.push({ SubjectId: id, Subject: name });
        });

        fetch("/api/Teachers/CreateSubject", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${userToken}`
            },
            body: JSON.stringify(subjects)
        })
        .then(res => res.json())
        .then(res => {
            if (res.status) {
                toastr.success(res.message || "Subjects added successfully!");
                closeCreateSubjectModal();
                loadSubjectsDropdown();
            } else {
                toastr.error(res.message || "Error adding subjects.");
            }
        })
        .catch(err => { console.error(err); toastr.error("Error adding subjects."); });
    });

    document.getElementById("createStudentForm").addEventListener("submit", function (e) {
        e.preventDefault();
        const classId = parseInt(document.getElementById("classDropdown").value, 10);
        const classNumber = parseInt(document.querySelector("#createStudentForm [name='ClassNumber']").value, 10);
        const name = document.querySelector("#createStudentForm [name='Name']").value.trim();
        const address = document.querySelector("#createStudentForm [name='Address']").value.trim();
        const parentName = document.querySelector("#createStudentForm [name='ParentName']").value.trim();
        const parentPhoneNumber = document.querySelector("#createStudentForm [name='ParentPhoneNumber']").value.trim();

        if (!classId || !classNumber || !name || !parentName || !parentPhoneNumber) {
            toastr.warning("Please fill all required fields.");
            return;
        }

        const payload = { ClassId: classId, ClassNumber: classNumber, Name: name, Address: address, ParentName: parentName, ParentPhoneNumber: parentPhoneNumber };

        fetch("/api/Students/CreateStudent", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Authorization": `Bearer ${userToken}` },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(res => {
            if (res.status) {
                toastr.success(res.message || "Student added successfully!");
                closeCreateStudentModal();
                populateSubjectDropdown($("#subjectFieldsWrapper .subjectDropdown").first());
                loadSubjectsDropdown();
                loadStudentsDropdown();
                loadStudentsScores();
            } else {
                toastr.error(res.message || "Error adding student.");
            }
        })
        .catch(err => { console.error(err); toastr.error("Error adding student."); });
    });

    /* --------- EDIT MODE: enable, cancel, save --------- */
    function enableScoreEditing() {
        if (!isOnlyStudent) return toastr.warning("Editing only allowed when a single student is selected.");
        isEditingScores = true;
        document.querySelectorAll("#scoreSheetTableBody .score-cell").forEach(td => {
            const val = td.textContent.trim();
            td.innerHTML = `<input type="number" min="0" max="100" value="${val}" style="width:60px;" />`;
        });
        document.getElementById("saveScoresBtn").style.display = "inline-block";
        document.getElementById("cancelEditBtn").style.display = "inline-block";
        document.getElementById("editScoresBtn").style.display = "none";
    }

    /* when cancelling, just reload original data */
    function cancelScoreEditing() {
        isEditingScores = false;
        document.getElementById("saveScoresBtn").style.display = "none";
        document.getElementById("cancelEditBtn").style.display = "none";
        document.getElementById("editScoresBtn").style.display = isOnlyStudent ? "inline-block" : "none";
        loadStudentsScores();
    }

    /* calculate row total from inputs */
    function updateRowTotal(row) {
        const first = parseInt(row.querySelector('[data-field="firstCA"] input')?.value || 0, 10);
        const second = parseInt(row.querySelector('[data-field="secondCA"] input')?.value || 0, 10);
        const exam = parseInt(row.querySelector('[data-field="exam"] input')?.value || 0, 10);
        const totalCell = row.querySelector('.col-total strong');
        const tot = (isNaN(first) ? 0 : first) + (isNaN(second) ? 0 : second) + (isNaN(exam) ? 0 : exam);
        if (totalCell) totalCell.textContent = tot;
        return tot;
    }

    /* Save all edited scores to endpoint (bulk) */
    function saveEditedScores() {
        const updatedScores = [];
        document.querySelectorAll("#scoreSheetTableBody tr").forEach(row => {
            const studentId = row.getAttribute("data-student-id");
            if (!studentId) return;
            const StudentScoreId = row.getAttribute("data-StudentScore-id");
            if (!StudentScoreId) return;
            const firstCAInput = row.querySelector('[data-field="firstCA"] input');
            const secondCAInput = row.querySelector('[data-field="secondCA"] input');
            const examInput = row.querySelector('[data-field="exam"] input');
            // if inputs aren't present, skip (not in edit-mode)
            if (!firstCAInput || !secondCAInput || !examInput) return;
            const firstCA = parseInt(firstCAInput.value || 0, 10);
            const secondCA = parseInt(secondCAInput.value || 0, 10);
            const exam = parseInt(examInput.value || 0, 10);
            const total = updateRowTotal(row);
            updatedScores.push({StudentScoreId, studentId, firstCA, secondCA, exam, total });
        });

        if (updatedScores.length === 0) {
            toastr.warning("No edited scores to save.");
            return;
        }

        fetch("/api/Students/UpdateScores", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Authorization": `Bearer ${userToken}`
            },
            body: JSON.stringify(updatedScores)
        })
        .then(res => res.json())
        .then(res => {
            if (res.status) {
                toastr.success(res.message || "Scores updated successfully!");
                cancelScoreEditing();
                loadStudentsScores();
            } else {
                toastr.error(res.message || "Error updating scores.");
            }
        })
        .catch(err => { console.error(err); toastr.error("Error updating scores."); });
    }

    /* update totals live while editing */
    document.getElementById("scoreSheetTableBody").addEventListener("input", function (e) {
        if (!isEditingScores) return;
        const input = e.target;
        if (input.tagName !== "INPUT") return;
        const row = input.closest("tr");
        if (!row) return;
        updateRowTotal(row);
    });

    /* --------- INIT --------- */
    $(document).ready(function () {
        // initial population
        populateClassDropdown();
        populateClassFilterDropdown();
        populateSubjectDropdown($("#subjectFieldsWrapper .subjectDropdown").first());
        loadSubjectsDropdown();
        loadStudentsDropdown();
        loadStudentsScores();

        // optional: initialize select2 for nicer selects if you want
        try {
          $("#subjectDropdown").select2({ width: '200px' });
          $("#studentDropdown").select2({ width: '200px' });
          $("#classFilterDropdown").select2({ width: '200px' });
        } catch (e) { /* select2 optional */ }
    });
</script>
