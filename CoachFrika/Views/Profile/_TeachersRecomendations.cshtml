@using CoachFrika.APIs.ViewModel
@using CoachFrika.Common
@model BaseResponse<List<GetCoachesRecommendationResponse>>

@{
    ViewBag.Title = "Teacher Recommendations";
}

<style>
    .teacherrec-top-bar {
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
    }

        .teacherrec-top-bar input[type="text"] {
            padding: 8px;
            font-size: 14px;
            width: 200px;
        }

        .teacherrec-top-bar button {
            padding: 8px 12px;
            font-size: 14px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

    .teacherrec-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
    }

    .teacherrec-card {
        flex: 1 1 calc(33.333% - 20px);
        background: #f9f9f9;
        padding: 20px;
        border: 1px solid #ddd;
        border-top: 4px solid #000;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

        .teacherrec-card h3 {
            margin-top: 0;
        }

        .teacherrec-card ul {
            padding-left: 20px;
        }

    .teacherrec-more-btn {
        background-color: #28a745;
        color: white;
        padding: 6px 10px;
        border: none;
        margin-top: 10px;
        cursor: pointer;
        border-radius: 4px;
    }

    .teacherrec-pagination {
        margin-top: 20px;
        text-align: center;
    }

        .teacherrec-pagination button {
            padding: 8px 14px;
            font-size: 14px;
            margin: 0 5px;
            border: none;
            background-color: #343a40;
            color: white;
            border-radius: 4px;
            cursor: pointer;
        }

        .teacherrec-pagination span {
            font-size: 16px;
            margin: 0 10px;
        }
</style>

<div class="teacherrec-top-bar">
    <input type="text" id="teacherrecSearchTitle" placeholder="Search by title..." />
    <button onclick="teacherrecSearch()">Search</button>
</div>

<div class="teacherrec-grid" id="teacherrecGrid">
    @if (Model?.Data == null || !Model.Data.Any())
    {
        <h3>No Recommendations Found</h3>
    }
    else
    {
        foreach (var rec in Model.Data)
        {
            <div class="teacherrec-card">
                <span class="teacherrec-page">Page 1</span>
                <h3>@rec.ScheduleTitle</h3>
                <h4>@rec.Recommendation</h4>
                <button class="teacherrec-more-btn" onclick="teacherrecLoadDetails('@rec.Id')">More</button>
            </div>
        }
    }
</div>

<div class="teacherrec-pagination">
    <button onclick="teacherrecPrevious()">Previous</button>
    <span id="teacherrecPageDisplay">Page 1</span>
    <button onclick="teacherrecNext()">Next</button>
</div>

<script>
    const teacherrecToken = "@Context.Session.GetString("Token")";
    let teacherrecPage = 1;
    const teacherrecPageSize = 6;

    document.addEventListener("DOMContentLoaded", () => {
        teacherrecLoad();
        teacherrecUpdateDisplay();
    });

    function teacherrecUpdateDisplay() {
        document.getElementById("teacherrecPageDisplay").textContent = `Page ${teacherrecPage}`;
    }

    function teacherrecSearch() {
        teacherrecPage = 1;
        teacherrecLoad();
    }

    function teacherrecLoad() {
        const title = document.getElementById("teacherrecSearchTitle").value.trim();
        const teacherId = document.getElementById("teacherrecSearchTeacher").value.trim();

        const query = new URLSearchParams({
            Title: title,
            TeacherId: teacherId,
            PageSize: teacherrecPageSize,
            PageNumber: teacherrecPage
        });

        fetch(`/api/Coaches/GetAllRecommendations?${query}`, {
            headers: {
                "Authorization": `Bearer ${teacherrecToken}`
            }
        })
        .then(res => {
            if (!res.ok) throw new Error("Server error");
            return res.json();
        })
        .then(res => {
            const container = document.getElementById("teacherrecGrid");
            container.innerHTML = "";

            if (res.data?.length) {
                res.data.forEach(rec => {
                    const remarks = rec.teacherRemark?.length
                        ? `<ul>${rec.teacherRemark.map(item => `<li>${item}</li>`).join("")}</ul>`
                        : "<p>No remarks</p>";

                    container.innerHTML += `
                        <div class="teacherrec-card">
                            <span class="teacherrec-page">Page ${teacherrecPage}</span>
                            <h3>${rec.scheduleTitle}</h3>
                            ${remarks}
                            <button class="teacherrec-more-btn" onclick="teacherrecLoadDetails('${rec.id}')">More</button>
                        </div>`;
                });
            } else {
                container.innerHTML = "<h4>No recommendations found.</h4>";
            }
        })
        .catch(() => toastr.error("Error loading recommendations"));
    }

    function teacherrecNext() {
        teacherrecPage++;
        teacherrecLoad();
        teacherrecUpdateDisplay();
    }

    function teacherrecPrevious() {
        if (teacherrecPage > 1) {
            teacherrecPage--;
            teacherrecLoad();
            teacherrecUpdateDisplay();
        }
    }

    function teacherrecLoadDetails(id) {
        // Placeholder: Replace this with actual modal loading logic
        toastr.info(`Loading details for ID: ${id}`);
    }
</script>
