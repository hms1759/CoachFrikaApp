@using CoachFrika.APIs.ViewModel
@using CoachFrika.Common
@model BaseResponse<List<GetCoachesRecommendationResponse>>

@{
    ViewBag.Title = "Recommendations";
}

<!-- Toastr styles -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<div class="rec-top-bar">
    <input type="text" id="searchTitle" placeholder="Search by title..." />
    <input type="text" id="searchTeacher" placeholder="Search by teacher ID..." />
    <button onclick="searchRecommendations()">Search</button>
</div>

<div class="recommendation-grid" id="recGrid">
    @if (Model?.Data == null || !Model.Data.Any())
    {
        <h3>No Recommendations Found</h3>
    }
    else
    {
        foreach (var rec in Model.Data)
        {
            <div class="recommendation-card" style="border-top: 4px solid black;">
                <span class="rec-page">@Model.PageNumber</span>
                <h3>@rec.ScheduleTitle</h3>
                <h4>@rec.Recommendation</h4>
                <button class="rec-more-btn" onclick="loadRecommendationDetails('@rec.Id')">More</button>
            </div>
        }
    }
</div>

<div class="pagination-controls">
    <button onclick="previousPage()">Previous</button>
    <span id="pageNumberDisplay">Page 1</span>
    <button onclick="nextPage()">Next</button>
</div>

<!-- Create Recommendation Modal -->
<div class="rec-modal" id="createRecModal">
    <div class="rec-modal-content">
        <span class="rec-modal-close" onclick="closeCreateRecModal()">×</span>
        <h2>Create Recommendation</h2>
        <form id="createRecForm">
            <label for="scheduleDropdown">Schedule:</label>
            <select id="scheduleDropdown" name="ScheduleId" required></select>

            <label for="teacherDropdown">Select Teachers:</label>
            <select id="teacherDropdown" name="TeacherIds" multiple required></select>

            <label for="recommendationText">Recommendation:</label>
            <textarea id="recommendationText" name="Recommendation" required></textarea>

            <button type="submit">Submit</button>
        </form>
    </div>
</div>

<!-- Details Modal -->
<div class="rec-modal" id="recModal">
    <div class="rec-modal-content">
        <span class="rec-modal-close" onclick="closeRecModal()">×</span>
        <h2>Recommendation Details</h2>
        <div class="rec-details-container" id="recDetailsContainer"></div>

        <form class="rec-form" id="recForm">
            <input type="hidden" id="recCommentId" name="Id" />
            <textarea name="Comment" id="recCommentInput" placeholder="Write a comment..." required></textarea>
            <button type="submit">Submit Comment</button>
        </form>
    </div>
</div>


<!-- Toastr and Scripts -->
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        const token = @Html.Raw(Context.Session.GetString("Token") ?? "");
        let currentPage = 1;
        const pageSize = 6;

        document.addEventListener("DOMContentLoaded", () => {
            loadRecommendations();
            updatePageNumberDisplay();
        });

        function updatePageNumberDisplay() {
            document.getElementById("pageNumberDisplay").textContent = `Page ${currentPage}`;
        }

        function searchRecommendations() {
            currentPage = 1;
            loadRecommendations();
        }

        function loadRecommendations() {
            const title = document.getElementById("searchTitle").value.trim();
            const teacherId = document.getElementById("searchTeacher").value.trim();

            const query = new URLSearchParams({
                Title: title,
                TeacherId: teacherId,
                PageSize: pageSize,
                PageNumber: currentPage
            });

            fetch(`/api/Coaches/GetAllRecommendations?${query}`, {
                headers: {
                    "Authorization": `Bearer ${token}`
                }
            })
                .then(res => res.json())
                .then(res => {
                    const container = document.getElementById("recGrid");
                    container.innerHTML = "";

                    if (res.data?.length) {
                        res.data.forEach(section => {
                            container.innerHTML += `
                                <div class="recommendation-card" style="border-top: 4px solid black;">
                                    <span class="rec-page">${currentPage}</span>
                                    <h3>${section.scheduleTitle}</h3>
                                    <ul>${section.teacherRemark.map(item => `<li>${item}</li>`).join("")}</ul>
                                    <button class="rec-more-btn" onclick="loadRecommendationDetails('${section.id}')">More</button>
                                </div>`;
                        });
                    } else {
                        container.innerHTML = "<h4>No recommendations found.</h4>";
                    }
                })
                .catch(() => toastr.error("Error loading recommendations"));
        }

        function nextPage() {
            currentPage++;
            loadRecommendations();
            updatePageNumberDisplay();
        }

        function previousPage() {
            if (currentPage > 1) {
                currentPage--;
                loadRecommendations();
                updatePageNumberDisplay();
            }
        }

        function loadRecommendationDetails(sectionId) {
            document.getElementById("recCommentId").value = sectionId;

            fetch(`/api/Recommendation/GetRecommendationDetails?sectionId=${sectionId}`, {
                headers: { "Authorization": `Bearer ${token}` }
            })
                .then(res => res.json())
                .then(res => {
                    const container = document.getElementById("recDetailsContainer");
                    container.innerHTML = "";

                    if (res.data?.length) {
                        res.data.forEach(detail => {
                            const alignment = detail.status === "left" ? "rec-detail-left" : "rec-detail-right";
                            container.innerHTML += `<div class="${alignment}"><strong>${detail.title}</strong><p>${detail.description}</p></div>`;
                        });
                        document.getElementById("recModal").style.display = "flex";
                    } else {
                        toastr.warning("No details found.");
                    }
                })
                .catch(() => toastr.error("Error loading details"));
        }

        function closeRecModal() {
            document.getElementById("recModal").style.display = "none";
        }

        document.getElementById("recForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const comment = document.getElementById("recCommentInput").value;
            const id = document.getElementById("recCommentId").value;

            fetch("/api/Recommendation/AddRecomendationsComment", {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${token}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ id: id ? parseInt(id) : null, comment })
            })
                .then(res => res.ok ? res.json() : Promise.reject())
                .then(() => {
                    toastr.success("Comment submitted successfully");
                    closeRecModal();
                    document.getElementById("recForm").reset();
                })
                .catch(() => toastr.error("Failed to submit comment"));
        });

        function openCreateRecModal() {
            document.getElementById("createRecModal").style.display = "flex";
            loadScheduleOptions();
            loadTeacherOptions();
        }

        function closeCreateRecModal() {
            document.getElementById("createRecModal").style.display = "none";
        }

        consol.log(token);
        function loadScheduleOptions() {
            fetch('/api/Schedule/GetScheduleList', {
                headers: { "Authorization": `Bearer ${token}` }
            })
                .then(res => res.json())
                .then(res => {
                    const dropdown = document.getElementById("scheduleDropdown");
                    dropdown.innerHTML = `<option value="">-- Select Schedule --</option>`;
                    res.data.forEach(s =>
                        dropdown.innerHTML += `<option value="${s.id}">${s.title} (${s.focus})</option>`
                    );
                });
        }
        consol.log(token);
        function loadTeacherOptions() {
            fetch('/api/Coaches/MyTeachers?IsPaginated=false', {
                headers: { "Authorization": `Bearer ${token}` }
            })
                .then(res => res.json())
                .then(res => {
                    const dropdown = document.getElementById("teacherDropdown");
                    dropdown.innerHTML = "";
                    res.data.forEach(t =>
                        dropdown.innerHTML += `<option value="${t.id}">${t.title} ${t.fullName}</option>`
                    );
                });
        }

        document.getElementById("createRecForm").addEventListener("submit", function (e) {
            e.preventDefault();

            const scheduleId = document.getElementById("scheduleDropdown").value;
            const teacherIds = Array.from(document.getElementById("teacherDropdown").selectedOptions).map(o => o.value);
            const recommendation = document.getElementById("recommendationText").value;

            fetch('/api/Recommendation/AddRecomendations', {
                method: "POST",
                headers: {
                    "Authorization": `Bearer ${token}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ ScheduleId: scheduleId, TeacherIds: teacherIds, Recommendation: recommendation })
            })
                .then(res => res.json())
                .then(() => {
                    toastr.success("Recommendation created successfully");
                    closeCreateRecModal();
                    loadRecommendations();
                })
                .catch(() => toastr.error("Error creating recommendation"));
        });
    </script>
}
