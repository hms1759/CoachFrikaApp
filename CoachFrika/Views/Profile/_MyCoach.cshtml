    <script>
        const coachData = {
            "Afeez IyioIa": [
                {
                    title: "Class Assessment",
                    details: [
                        { label: "Differentiated Instruction", content: "Use diverse strategies..." },
                        { label: "Inclusive Practices", content: "Ensure inclusivity..." }
                    ],
                    date: "Tuesday, 8th Jan, 2024",
                    time: "2:45 PM"
                },
                {
                    title: "Time Management",
                    details: [
                        { label: "Effective Scheduling", content: "Break time into manageable parts..." },
                        { label: "Classroom Efficiency", content: "Reduce downtime between transitions..." }
                    ],
                    date: "Tuesday, 8th Jan, 2024",
                    time: "2:43 PM"
                }
            ],
            "Akeem Badru": [
                {
                    title: "Learning Strategies",
                    details: [
                        { label: "Interactive Lessons", content: "Use hands-on learning materials..." }
                    ],
                    date: "Monday, 7th Jan, 2024",
                    time: "3:00 PM"
                }
            ],
            "Solomon Asuquo": [
                {
                    title: "Communication Skills",
                    details: [
                        { label: "Student Engagement", content: "Ask open-ended questions..." }
                    ],
                    date: "Monday, 7th Jan, 2024",
                    time: "1:15 PM"
                }
            ]
            // Add more data if needed
        };

        function renderRecommendations(coach) {
            const container = document.getElementById('recommendationsContainer');
            const coachName = document.getElementById('coachName');
            const data = coachData[coach] || [];

            coachName.textContent = `Recommendations - ${coach}`;
            container.innerHTML = '';

            data.forEach(rec => {
                const card = document.createElement('div');
                card.className = 'card mb-3';
                card.innerHTML = `
                  <div class="card-body">
                    <h6 class="text-success">${rec.title}:</h6>
                    ${rec.details.map(d => `<p><strong>${d.label}:</strong> ${d.content}</p>`).join('')}
                    <div class="d-flex justify-content-between">
                      <small class="text-muted">${rec.date} | <span class="text-danger">${rec.time}</span></small>
                      <a href="#" class="text-danger small">Mark as read</a>
                    </div>
                  </div>
                `;
                container.appendChild(card);
            });
        }

        // Initial Load
        renderRecommendations("Afeez IyioIa");

        // Click Event
        document.querySelectorAll(".coach-item").forEach(item => {
            item.addEventListener("click", function () {
                document.querySelectorAll(".coach-item").forEach(el => el.classList.remove("active"));
                this.classList.add("active");
                const coachName = this.getAttribute("data-coach");
                renderRecommendations(coachName);
            });
        });
    </script>
