<div class="space"></div>

<!-- Top Bar -->
<div class="teacher-top-bar">
    <span class="title">Coach and I</span>
    <div class="search-box">
        <input type="text" id="teacherSearchInput" class="teacher-search-input" placeholder="Search by name..." />
        <button class="teacher-view-all-btn" onclick="handleTeacherSearch()">Search</button>
        <button class="teacher-view-all-btn" onclick="openRecModal()">View Recommendation</button>
    </div>
</div>

<div class="space"></div>

<!-- Teacher Cards -->
<div class="teacher-card-wrapper" id="teacherCardWrapper">Loading...</div>

<!-- Pagination -->
<div class="teacher-pagination" id="teacherPagination">
    <button onclick="goToPreviousPage()">Previous</button>
    <span id="teacherPageInfo">Page 1</span>
    <button onclick="goToNextPage()">Next</button>
</div>

<script>
    (() => {

    const authToken = @Html.Raw(Context.Session.GetString("Token") ?? "");
        const userId = getUserIdFromToken(authToken);
        const seletedcoachId = getseletedcoachIdFromToken(authToken);
        let pageNumber = 1;
        const pageSize = 10;
        let searchTerm = '';

        function getUserIdFromToken(token) {
            if (!token) return null;
            try {
                const payload = JSON.parse(atob(token.split('.')[1]));
                return payload.Profile.id;
            } catch (err) {
                console.error("Invalid token:", err);
                return null;
            }
        }
            function getseletedcoachIdFromToken(token) {
        if (!token) return null;

        try {
            const payload = JSON.parse(atob(token.split('.')[1]));

                console.log(payload.Profile);
            // Profile is a JSON string, so parse it
            const profile = typeof payload.Profile === 'string'
                ? JSON.parse(payload.Profile)
                : payload.Profile;

            console.log("Decoded CoachId:", profile.CoachId);

            return profile.CoachId || null;
        } catch (err) {
            console.error("Invalid token:", err);
            return null;
        }
    }

        function handleTeacherSearch() {
            searchTerm = document.getElementById("teacherSearchInput").value.trim();
            pageNumber = 1;
            loadTeachers();
        }

        function loadTeachers() {
            const url = `/api/Coaches/GetAllCoaches?IsPaginated=true&Name=${encodeURIComponent(searchTerm)}&PageSize=${pageSize}&PageNumber=${pageNumber}`;

            fetch(url, {
                headers: { "Authorization": `Bearer ${authToken}` }
            })
            .then(res => res.json())
            .then(data => {
                const wrapper = document.getElementById("teacherCardWrapper");
                wrapper.innerHTML = "";

                if (!data?.data?.length) {
                    wrapper.innerHTML = "<p>No teachers found.</p>";
                    return;
                }
                    data.data.forEach(teacher => {
        const card = document.createElement("div");
        card.className = "teacher-card";

        const image = teacher.imageUrl || 'https://img.freepik.com/free-vector/smiling-young-man-illustration_1308-174669.jpg?semt=ais_hybrid&w=740';
        const name = teacher.fullName || 'No Name';
        const school = teacher.schoolName || 'Unknown School';


        // Conditionally render the Select button
        const actionButton = seletedcoachId == null
            ? `<button class="teacher-recommendation-btn" onclick="selectCoach('${teacher.id}')">Select</button>`
            : `<span class="already-selected-label">Already Selected</span>`;

            console.log(seletedcoachId)
            console.log(actionButton)
        card.innerHTML = `
            <div class="teacher-card">
                <img src="${image}" alt="${name}" class="teacher-card-img" />
                <div class="teacher-card-content">
                    <p class="teacher-name">${name}</p>
                    <p class="teacher-school">${school}</p>
                    <div class="teacher-btn">
                        <a href="/Profile/Details?id=${teacher.id}">
                            <button class="teacher-view-btn">View Details</button>
                        </a>
                        ${actionButton}
                    </div>
                </div>
            </div>
        `;

        wrapper.appendChild(card);
    });


                document.getElementById("teacherPageInfo").textContent = `Page ${pageNumber}`;
            })
            .catch(err => {
                console.error("Error fetching teachers:", err);
                document.getElementById("teacherCardWrapper").innerHTML = "<p>Error loading teachers.</p>";
            });
        }

        window.selectCoach = function (coachId) {
            if (!authToken) {
                alert("You are not authenticated.");
                return;
            }

            fetch(`/api/Teachers/SelectCoach?CoachId=${coachId}`, {
                method: "PUT",
                headers: {
                    "Authorization": `Bearer ${authToken}`,
                    "Content-Type": "application/json"
                }
            })
            .then(res => {
                if (!res.ok) {
                    return res.text().then(text => { throw new Error(text); });
                }
                return res.json();
            })
            .then(() => {
                alert("Coach selected successfully!");
                loadTeachers();
            })
            .catch(err => {
                console.error("Error selecting coach:", err);
                alert("Failed to select coach: " + err.message);
            });
        };

        window.goToNextPage = () => {
            pageNumber++;
            loadTeachers();
        };

        window.goToPreviousPage = () => {
            if (pageNumber > 1) {
                pageNumber--;
                loadTeachers();
            }
        };

        window.handleTeacherSearch = handleTeacherSearch;

        // Initial load
        loadTeachers();
    })();
</script>
