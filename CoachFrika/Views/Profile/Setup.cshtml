@{
    ViewBag.Title = "Profile Setup";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Setup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <style>
        body {
            /* background-color: #28a745; */
            background-color: #A1D154;
        }

        .form-wrapper {
            background-color: #fff;
            border-radius: 10px;
            padding: 20px;
            max-width: 600px;
            width: 100%;
            margin: 50px auto;
        }

        .step-indicator .step {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e9ecef;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #6c757d;
            font-weight: bold;
        }

            .step-indicator .step.active {
                background-color: #28a745;
                color: #fff;
            }

        .step-indicator .step-line {
            flex: 1;
            height: 2px;
            background-color: #e9ecef;
        }

        .step-indicator .step.active + .step-line {
            background-color: #28a745;
        }

        .camera-icon {
            font-size: 50px;
            color: #6c757d;
        }

        .hidden {
            display: none;
        }
    </style>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="d-flex justify-content-center align-items-center vh-100 p-3">
        <div class="form-wrapper shadow">
            <h3 class="text-center text-success">Welcome Bukky!</h3>
            <p class="text-center">Let us quickly set up your profile</p>

            <!-- Step Indicator -->
            <div class="d-flex align-items-center step-indicator mb-4">
                <div class="step active">1</div>
                <div class="step-line"></div>
                <div class="step">2</div>
                <div class="step-line"></div>
                <div class="step">3</div>
                <div class="step-line"></div>
                <div class="step">4</div>
                <div class="step-line"></div>
                <div class="step">5</div>
            </div>
            @model ProfileSetupViewModel
            <!-- Form Steps -->
            <form id="profile-setup-form" method="post" enctype="multipart/form-data">
                <!-- Step 1 -->
                <div class="step-content" id="step-1">
                    <h5>Tell us about yourself</h5>
                    <div class="mb-3">
                        <label for="title" class="form-label">Select your Title</label>
                        <select class="form-select" id="title" asp-for="Title">
                            <option selected disabled>Choose your title</option>
                            <option value="1">Mr.</option>
                            <option value="2">Mrs.</option>
                            <option value="3">Miss</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="background" class="form-label">Enter your background information</label>
                        <textarea asp-for="Background" class="form-control" id="background" rows="3" placeholder="Enter your background information"></textarea>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="step-content d-none" id="step-2">
                    <h5>Enter your School details</h5>
                    <div class="mb-3">
                        <input asp-for="SchoolName" type="text" class="form-control" placeholder="School Name">
                    </div>
                    <div class="mb-3">
                        <input asp-for="SchoolAddress" type="text" class="form-control" placeholder="School Address">
                    </div>
                    <div class="mb-3">
                        <input asp-for="StudentsCount" type="number" class="form-control" placeholder="Number of Students">
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="step-content d-none" id="step-3">
                    <h5>Experience Information</h5>
                    <div class="mb-3">
                        <input asp-for="YearsExperience" type="number" class="form-control" placeholder="Year of Experience">
                    </div>
                    <div class="mb-3">
                        <input asp-for="SubjectTaught" type="text" class="form-control" placeholder="Subject Taught">
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="step-content d-none" id="step-4">
                    <h5 class="text-center mb-3">Upload Your Profile Picture</h5>
                    <div class="text-center mb-3">
                        <i class="fas fa-camera camera-icon"></i>
                    </div>
                    <div class="mb-3">
                        <input asp-for="ProfilePicture" type="file" class="form-control" id="profile-pic-input" accept="image/*">
                    </div>
                    <div class="text-center">
                        <img id="profile-pic-preview" class="img-thumbnail hidden" alt="Profile Preview" width="150">
                    </div>
                </div>

                <!-- Step 5 -->
                <div class="step-content d-none" id="step-5">
                    <h5 class="text-center mb-4"><strong>Kindly choose a plan to complete your registration</strong></h5>
                    <div class="text-center">
                        <button type="button" class="btn btn-success">Choose Your Plan</button>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <button type="button" class="btn btn-secondary" id="prev-btn" disabled>Previous</button>
                    <button type="button" class="btn btn-success" id="next-btn">Next</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentStep = 1;

        const updateSteps = () => {
            document.querySelectorAll('.step').forEach((step, index) => {
                step.classList.toggle('active', index < currentStep);
            });

            document.querySelectorAll('.step-content').forEach((content, index) => {
                content.classList.toggle('d-none', index !== currentStep - 1);
            });

            const prevButton = document.getElementById('prev-btn');
            const nextButton = document.getElementById('next-btn');

            prevButton.disabled = currentStep === 1;

            if (currentStep === 4) {
                nextButton.textContent = 'Save and Continue';
                nextButton.classList.remove('hidden');
            } else if (currentStep === 5) {
                nextButton.classList.add('hidden');
            } else {
                nextButton.textContent = 'Next';
                nextButton.classList.remove('hidden');
            }
        };

        document.getElementById('next-btn').addEventListener('click', () => {
            if (currentStep < 5) {
                currentStep++;
                updateSteps();
            }
        });

        document.getElementById('prev-btn').addEventListener('click', () => {
            if (currentStep > 1) {
                currentStep--;
                updateSteps();
            }
        });

        // Preview the uploaded profile picture
        document.getElementById('profile-pic-input').addEventListener('change', (event) => {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const preview = document.getElementById('profile-pic-preview');
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>