<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Bootstrap MVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="wrapper">
        <div class="nav-dev">
            <nav class="navbar navbar-expand-lg navbar-light bg-transparent w-100">
                <div class="container">
                    <!-- Left-aligned logo -->
                    <a class="navbar-brand" href="index.html">
                        <img src="images/logo.png" class="top_logo" alt="">
                    </a>

                    <!-- Toggle button for mobile -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <!-- Right-aligned navigation links -->
                    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                        <ul class="navbar-nav">
                            <li class="nav-item nna"><a class="nav-link" href="">Home</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="Pricing">Pricing</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="Service">Services</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="Blog">Blog</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="Dashboard">Dashboard</a></li>
                            <li class="nav-item nna"><a class="nav-link" asp-controller="Home" asp-action="JoinUs">Join Us</a></li>
                   
                        </ul>
                    </div>
                </div>
            </nav>
        </div>
        <br />
        <!-- Main Content -->
        <div class="container mt-4 content">
            @RenderBody()
        </div>

        <!-- div 8: Text + Input Field -->
        <div class="div text-center bg-lightgray">
            <h2>Subscribe</h2>
            <input type="text" class="form-control w-75 w-md-50 mx-auto" placeholder="Enter your email">
        </div>
        <!-- Footer -->
        <div class="footer">
            <div class="bg-light text-center">
                <div class="d-flex justify-content-between">
                    <span class="mx-2">Item 1</span>
                    <span class="mx-2">Item 2</span>
                    <span class="mx-2">Item 3</span>
                    <span class="mx-2">Item 4</span>
                </div>
            </div>
            <div class="text-center bg-lightgray">
                <h4>Homemade</h4>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>