<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - CoachFrica</title>
    <link rel="icon" type="image/png" href="~/images/logo-removebg-preview.jpg" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
</head>
<body class="@ViewData["BodyClass"]">
    <div class="wrapper">
        <div class="nav-dev">
            <nav class="navbar navbar-expand-lg navbar-light bg-transparent w-100">
                <div class="container">
                    <!-- Left-aligned logo -->
                    <a class="navbar-brand" href="index.html">
                        <img src="~/images/logo-removebg-preview.jpg" />
                    </a>

                    <!-- Toggle button for mobile -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <!-- Right-aligned navigation links -->
                    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                        <ul class="navbar-nav">
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")"
                                   asp-controller="Home" asp-action="About">About</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Pricing" ? "active" : "")"
                                   asp-controller="Home" asp-action="Pricing">Pricing</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")"
                                   asp-controller="Home" asp-action="Contact">Contact Us</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Service" ? "active" : "")"
                                   asp-controller="Home" asp-action="Service">Services</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Blog" ? "active" : "")"
                                   asp-controller="Home" asp-action="Blog">Blog</a>
                            </li>
                            <li class="nav-item nna">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                                   asp-controller="Profile" asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item nna_join">
                                <a class="nav-link" asp-controller="Account" asp-action="SignUp">Join Us</a>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </div>
        <br />
        <!-- Main Content -->
        <div class="container">
            @RenderBody()
        </div>

        <!-- div 8: Text + Input Field -->
        <div class="text-center Subscribe-Contain ">
            <div id="subscribe-message" class="text-center mt-2"></div>
            <br />
            <h2>Subscribe to our newsletter</h2>
            <br />
            <p>We recommend you to subscribe to our newsletter, drop your <br />email below to get daily updates about us.</p>

            <br /><br />
            <div class="d-flex justify-content-center align-items-center">
                <input type="email" id="subscribe-email" class="form-control w-50 custom-input" placeholder="Enter your email address" required />
                <button type="button" id="subscribe-btn" class="btn btn-green ms-2">Subscribe</button>
            </div>
            

        </div>

        <!-- Footer -->
        <div class="footer">
            <div class="text-center">
                <div class="d-flex justify-content-between">
                    <div class="ft edtech">

                        Coachfrika is an innovative edtech
                        social enterprise that provides
                        personalized coaching support to
                        teachers in public and private
                        schools across Nigeria. .....
                        <br />
                        <img src="~/images/logo-removebg-preview.jpg" />
                    </div>
                    <div class="ft quick">
                        <div class="ft-topic">Quick Links</div>

                        <div>Home</div>
                        <div>
                            About
                        </div>
                        <div>
                            Sign Up
                        </div>
                    </div>
                    <div class="ft company">

                        <div class="ft-topic">Company</div>
                        <div>
                            Service
                        </div>
                        <div>
                            Contact
                        </div>
                        <div>
                            Privacy Policy
                        </div>

                    </div>
                    <div class="ft withus">

                        <div class="ft-topic">Connect with us</div>
                        <br /> <br />
                        <div>Contact Us</div>

                    </div>
                </div>
            </div>
            <div class="text-center copyright">
                <div>© Coachfrika. All rights reserved.</div>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script>
        document.getElementById('subscribe-btn').addEventListener('click', function () {
            const emailInput = document.getElementById('subscribe-email');
            const email = emailInput.value.trim();
            const messageBox = document.getElementById('subscribe-message');

            const apiUrl = '@Url.Content("~/api/Public/NewSubscription")';
            if (!email) {
                messageBox.textContent = 'Please enter your email.';
                messageBox.style.color = 'red';
                return;
            }
            fetch(apiUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ email: email })
            })
                .then(response => {
                    if (!response.ok) throw new Error('Network error');
                    return response.json();
                })
                .then(data => {
                    messageBox.textContent = 'Subscription successful!';
                    messageBox.style.color = 'green';
                    emailInput.value = '';
                })
                .catch(error => {
                    console.error(error);
                    messageBox.textContent = 'Failed to subscribe. Please try again.';
                    messageBox.style.color = 'red';
                });
        });
    </script>

</body>

</html>