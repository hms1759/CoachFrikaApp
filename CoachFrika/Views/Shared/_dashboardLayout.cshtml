<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>@ViewData["Title"] - CoachFrica</title>
    <link rel="icon" type="image/png" href="~/images/logo-removebg-preview.jpg" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/slidebar.js" asp-append-version="true"></script>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

</head>

<body class="@ViewData["BodyClass"]">
    <div class="d-flex" id="layoutContainer">
        <div class="sidebar collapsed" id="sidebar">
            <div class="sidebar-header">
                <img src="~/images/dashdoardlogo.png" class="logo" />
            </div>

            <ul class="sidebar-menu">
                <li>
                    @Html.ActionLink("Dashboard", "Index", "Profile", null, new { @class = "sidebar-item" })
                    <i class="fas fa-home"></i>
                </li>
                <li>
                    @Html.ActionLink("Live Classes", "Live", "Classes", null, new { @class = "sidebar-item" })
                    <i class="fas fa-broadcast-tower"></i>
                </li>
                <li>
                    @Html.ActionLink("Schedule", "Inbox", "Messages", null, new { @class = "sidebar-item" })
                    <i class="fas fa-calendar-alt"></i>
                </li>
                <li>
                    @Html.ActionLink("My Coach & I", "Settings", "Account", null, new { @class = "sidebar-item" })
                    <i class="fas fa-user-friends"></i>
                </li>
            </ul>

            <button class="logout-btn bg-light text-danger">
                <i class="fas fa-sign-out-alt"></i> Log Out
            </button>
        </div>


        <div class="main-content collapsed flex-grow-1 p-3" id="mainContent">
            @* <button id="openSidebar" class="btn btn-outline-secondary mb-2 d-none">☰ Menu</button> *@
            @RenderBody()

        </div>
    </div>
    @RenderSection("Scripts", required: false)
    </body>
</html>
