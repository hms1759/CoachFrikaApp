<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - CoachFrica</title>
    <link rel="icon" type="image/png" href="~/images/logo-removebg-preview.jpg" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/slidebar.js" asp-append-version="true"></script>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="@ViewData["BodyClass"]">
    <div class="d-flex" id="layoutContainer">
        <div class="sidebar" id="sidebar">
            <button id="closeSidebar" class="btn btn-sm btn-outline-secondary m-2">✖</button>
            <img src="~/images/dashdoardlogo.png" />
            <div class="d-flex justify-content-evenly">
                <img src="~/images/vector2.png" />
                @Html.ActionLink("Dashboard", "Index", "Profile", null, new { @class = "nav-link" })
            </div>
            <div class="d-flex justify-content-evenly">
                <img src="~/images/vector3.png" />
                @Html.ActionLink("Schedule", "Inbox", "Messages", null, new { @class = "nav-link" })
            </div>
            <div class="d-flex justify-content-evenly">
                <img src="~/images/ppl.png" />
                @Html.ActionLink("My Coach and I", "Settings", "Account", null, new { @class = "nav-link" })
            </div>
            <div class="d-flex justify-content-center mt-4">
                <img src="~/images/group27.png" />
                @Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "nav-link" })
            </div>
        </div>

        <div class="main-content flex-grow-1 p-3" id="mainContent">
            <button id="openSidebar" class="btn btn-outline-secondary mb-2 d-none">☰ Menu</button>
            @RenderBody()

        </div>
    </div>
    @RenderSection("Scripts", required: false)
    </body>
</html>
