@using CoachFrika.APIs.ViewModel
@using CoachFrika.Common
@model BaseResponse<List<ProfileDto>>

@{
    Layout = null;
    ViewBag.Title = "Scheme";

    var statusOptions = new Dictionary<string, string>
    {
        { "", "All Plans" },
        { "0", "Intentional" },
        { "1", "Phenomenal" },
        { "2", "Transformational" }
    };
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="bkcoaches-container">
    <div class="bkcoaches-header">
        <h2>Scheme</h2>
        <div class="bkcoaches-searchbar">
            <input type="text" id="searchName" placeholder="Search by title..." />
            <select id="statusFilter">
                @foreach (var option in statusOptions)
                {
                    <option value="@option.Key">@option.Value</option>
                }
            </select>
            <select id="pageSize">
                <option value="10">10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
            </select>
            <button id="searchBtn">Search</button>
            <button id="openCreateModal">+ Create Scheme</button>
        </div>
    </div>

    <table class="bkcoaches-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Plan</th>
                <th>Week</th>
                <th>Description</th>
                <th>Created By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="6">Loading Schemes...</td></tr>
        </tbody>
    </table>
    <div class="bkcoaches-pagination"></div>
</div>

<!-- Create/Edit Modal -->
<div id="schemeModal" class="modal" style="display:none;">
    <div class="modal-content">
        <h3 id="modalTitle">Create Scheme</h3>
        <form id="schemeForm">
            <input type="hidden" id="schemeId" />

            <div class="form-group">
                <label for="schemeTitle">Title</label>
                <input type="text" id="schemeTitle" required />
            </div>

            <div class="form-group">
                <label for="schemeDescription">Description</label>
                <textarea id="schemeDescription" required></textarea>
            </div>

            <div class="form-group">
                <label for="schemeWeek">Week Number</label>
                <input type="number" id="schemeWeek" required />
            </div>

            <div class="form-group">
                <label for="schemePlan">Plan</label>
                <select id="schemePlan" required>
                    <option value="0">Intentional</option>
                    <option value="1">Phenomenal</option>
                    <option value="2">Transformational</option>
                </select>
            </div>

            <div class="modal-actions">
                <button type="submit" id="saveSchemeBtn" class="btn btn-primary">Save</button>
                <button type="button" id="closeModal" class="btn btn-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* Container */
    .bkcoaches-container {
        margin: 20px;
    }

    .bkcoaches-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .bkcoaches-searchbar select,
    .bkcoaches-searchbar input,
    .bkcoaches-searchbar button {
        margin-right: 8px;
    }

    /* Table */
    .bkcoaches-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
    }

        .bkcoaches-table th, .bkcoaches-table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }

        .bkcoaches-table th {
            background: #f5f5f5;
        }

    /* Modal backdrop */
    .modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .modal-content {
        background: #fff;
        padding: 25px 30px;
        border-radius: 12px;
        width: 420px;
        max-width: 90%;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        animation: fadeIn 0.3s ease;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            font-weight: 500;
            margin-bottom: 6px;
            display: block;
        }

        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .btn {
        padding: 8px 16px;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn-primary {
        background: #007bff;
        color: #fff;
    }

        .btn-primary:hover {
            background: #0056b3;
        }

    .btn-secondary {
        background: #ccc;
        color: #333;
        margin-left: 10px;
    }

        .btn-secondary:hover {
            background: #aaa;
        }

    /* Row actions */
    .scheme-btn {
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        transition: 0.2s;
    }

    .edit-btn {
        background: #3498db;
        color: #fff;
    }

        .edit-btn:hover {
            background: #2980b9;
        }

    .delete-btn {
        background: #e74c3c;
        color: #fff;
        margin-left: 5px;
    }

        .delete-btn:hover {
            background: #c0392b;
        }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<script>
    var currentPage = 1;

    $(document).ready(function () {
        loadScheme(currentPage);

        $("#searchBtn").click(() => { currentPage = 1; loadScheme(currentPage); });
        $("#pageSize").change(() => loadScheme(currentPage));
        $("#openCreateModal").click(() => { resetModal(); $("#modalTitle").text("Create Scheme"); $("#schemeModal").show(); });
        $("#closeModal").click(() => $("#schemeModal").hide());
        $("#schemeForm").submit(e => { e.preventDefault(); saveScheme(); });
    });

    function loadScheme(pageNumber) {
        $.ajax({
            url: '/api/Schemes/GetAllScheme',
            method: 'GET',
            headers: { "Authorization": "Bearer " + userToken },
            data: {
                Title: $('#searchName').val(),
                Plans: $('#statusFilter').val() || null,
                PageSize: $('#pageSize').val(),
                PageNumber: pageNumber
            },
            success: res => {
                renderSchemeTable(res.data);
                renderPagination(res.totalCount, pageNumber, $('#pageSize').val());
            },
            error: xhr => toastr.error(xhr.responseText || "Failed to load schemes.")
        });
    }

    function renderSchemeTable(data) {
        const tbody = $('.bkcoaches-table tbody').empty();
        if (!data?.length) return tbody.append('<tr><td colspan="6">No Scheme found.</td></tr>');

        data.forEach(s => {
            tbody.append(`
                <tr>
                    <td>${s.title}</td>
                    <td>${s.plan}</td>
                    <td>${s.weekNumber || 0}</td>
                    <td>${s.description}</td>
                    <td>${s.createdBy}</td>
                    <td>
                        <button class="scheme-btn edit-btn"
                            data-id="${s.id}"
                            data-title="${s.title.replace(/"/g, '&quot;')}"
                            data-description="${s.description.replace(/"/g, '&quot;')}"
                            data-week="${s.weekNumber}"
                            data-plan="${s.plan}">
                            Edit
                        </button>
                        <button class="scheme-btn delete-btn" data-id="${s.id}">Delete</button>
                    </td>
                </tr>
            `);
        });
    }

    function renderPagination(totalCount, pageNumber, pageSize) {
        const pagination = $('.bkcoaches-pagination').empty();
        const totalPages = Math.ceil(totalCount / pageSize);
        if (totalPages <= 1) return;

        if (pageNumber > 1) pagination.append(`<button onclick="loadScheme(${pageNumber - 1})">Prev</button>`);
        for (let i = 1; i <= totalPages; i++) {
            pagination.append(`<button class="${i === pageNumber ? 'active' : ''}" onclick="loadScheme(${i})">${i}</button>`);
        }
        if (pageNumber < totalPages) pagination.append(`<button onclick="loadScheme(${pageNumber + 1})">Next</button>`);
    }

    function saveScheme() {
        const id = $("#schemeId").val();
        const payload = {
            title: $("#schemeTitle").val(),
            description: $("#schemeDescription").val(),
            weekNumber: parseInt($("#schemeWeek").val()),
            plan: parseInt($("#schemePlan").val())
        };

        $.ajax({
            url: id ? `/api/Schemes/EditScheme/${id}` : `/api/Schemes/CreateScheme`,
            method: id ? "PUT" : "POST",
            headers: { "Authorization": "Bearer " + userToken },
            contentType: "application/json",
            data: JSON.stringify(payload),
            success: () => {
                toastr.success("Scheme saved successfully.");
                $("#schemeModal").hide();
                loadScheme(currentPage);
            },
            error: xhr => toastr.error(xhr.responseText || "Failed to save scheme.")
        });
    }

    $(document).on("click", ".edit-btn", function () {
        const b = $(this);
        $("#schemeId").val(b.data("id"));
        $("#schemeTitle").val(b.data("title"));
        $("#schemeDescription").val(b.data("description"));
        $("#schemeWeek").val(b.data("week"));
        $("#schemePlan").val(b.data("plan"));
        $("#modalTitle").text("Edit Scheme");
        $("#schemeModal").show();
    });

    $(document).on("click", ".delete-btn", function () {
        const id = $(this).data("id");
        if (!confirm("Are you sure you want to delete this scheme?")) return;

        $.ajax({
            url: `/api/Schemes/DeleteScheme/${id}`,
            method: "DELETE",
            headers: { "Authorization": "Bearer " + userToken },
            success: () => { toastr.success("Scheme deleted successfully."); loadScheme(currentPage); },
            error: xhr => toastr.error(xhr.responseText || "Failed to delete scheme.")
        });
    });

    function resetModal() {
        $("#schemeForm")[0].reset();
        $("#schemeId").val("");
        $("#schemePlan").val("0");
    }
</script>
