@using CoachFrika.APIs.ViewModel
@using CoachFrika.Common
@model BaseResponse<List<ProfileDto>>

@{
    Layout = null;
    ViewBag.Title = "Schedules";

    var statusOptions = new Dictionary<string, string>
    {
        { "", "All Plans" },
        { "1", "Intentional" },
        { "2", "Phenomenal" },
        { "3", "Transformational" }
    };
}

<div class="bkcoaches-container">
    <div class="bkcoaches-header">
        <h2>Coaches</h2>
        <div class="bkcoaches-searchbar">
            <input type="text" id="searchName" placeholder="Search by name..." />
            <select id="statusFilter">
                @foreach (var option in statusOptions)
                {
                    <option value="@option.Key">@option.Value</option>
                }
            </select>
            <select id="pageSize">
                <option value="10">10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
            </select>
            <button id="searchBtn">Search</button>
        </div>
    </div>

    <table class="bkcoaches-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Plan</th>
                <th>Duration</th>
                <th>StartTime</th>
                <th>EndTime</th>
                <th>CreatedBy</th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="6">Loading Schedules...</td></tr>
        </tbody>
    </table>

    <div class="bkcoaches-pagination"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var currentPage = 1;

    $('#searchBtn').on('click', function () {
        currentPage = 1;
        loadCoaches(currentPage);
    });

    $('#pageSize').on('change', function () {
        if (currentPage > 0) loadCoaches(currentPage);
    });

    function convertStatusToOnboarding(uiStatus) {
        if (uiStatus === "1") return 0; // Ongoing
        if (uiStatus === "2") return 1; // Pending
        if (uiStatus === "3") return 2; // Approved
        return null;
    }

    function loadCoaches(pageNumber) {
        const name = $('#searchName').val();
        const uiStatus = $('#statusFilter').val();
        const pageSize = $('#pageSize').val();
        const Plans = convertStatusToOnboarding(uiStatus);

        $.ajax({
            url: '/api/BackOfficeAPI/GetAllSchedules',
            headers: { "Authorization": "Bearer " + userToken },
            method: 'GET',
            data: {
                Name: name,
                Plans: Plans,
                PageSize: pageSize,
                PageNumber: pageNumber
            },
            success: function (response) {
                renderCoachTable(response.data);
                renderPagination(response.totalCount, pageNumber, pageSize);
            },
            error: function () {
                alert("Failed to load data.");
            }
        });
    }

    function renderCoachTable(data) {
        const tbody = $('.bkcoaches-table tbody');
        tbody.empty();

        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="6">No Schedule found.</td></tr>');
            return;
        }

        // data.forEach(schedule => {
        //     let statusLabel = coach.stages < 4
        //         ? 'Ongoing'
        //         : (coach.stages === 4 && coach.hasPaid ? 'Approved' : 'Pending');

        //     let statusClass = statusLabel.toLowerCase();
        //     let actionButtons = `
        //             <button onclick="viewCoach('${coach.id}')">View</button>
        //             ${statusLabel === 'Pending' ? `<button onclick="editCoach('${coach.id}')">Approve</button>` : ''}
        //         `;

        //     tbody.append(`
        //             <tr>
        //                 <td>${coach.title}</td>
        //                 <td>${coach.focus}</td>
        //                 <td>${coach.duration}</td>
        //                 <td>${coach.startDate}</td>
        //                 <td>${coach.endDate}</td>}</td>
        //             </tr>
        //         `);
        // });

            data.forEach(coach => {
        const start = new Date(coach.startDate);
        const end = new Date(coach.endDate);
        const diffMinutes = Math.floor((end - start) / 60000);
        const hours = Math.floor(diffMinutes / 60);
        const minutes = diffMinutes % 60;
        const duration = hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;

        tbody.append(`
            <tr>
                <td>${coach.title}</td>
                <td>${coach.focus}</td>
                <td>${duration}</td>
                <td>${start.toLocaleString()}</td>
                <td>${end.toLocaleString()}</td>
                <td>${coach.createdBy}</td>
            </tr>
        `);
    });
    }

    function renderPagination(totalCount, pageNumber, pageSize) {
        const pagination = $('.bkcoaches-pagination');
        pagination.empty();

        const totalPages = Math.ceil(totalCount / pageSize);
        if (totalPages <= 1) return;

        if (pageNumber > 1) {
            pagination.append(`<button class="page-btn" onclick="loadCoaches(${pageNumber - 1})">Prev</button>`);
        }

        for (let i = 1; i <= totalPages; i++) {
            const active = i === pageNumber ? 'active' : '';
            pagination.append(`<button class="page-btn ${active}" onclick="loadCoaches(${i})">${i}</button>`);
        }

        if (pageNumber < totalPages) {
            pagination.append(`<button class="page-btn" onclick="loadCoaches(${pageNumber + 1})">Next</button>`);
        }

        currentPage = pageNumber;
    }

    function toggleMenu(button) {
        document.querySelectorAll('.bkcoaches-dropdown').forEach(d => d.classList.remove('show'));
        const dropdown = button.nextElementSibling;
        dropdown.classList.toggle('show');
    }

    window.addEventListener('click', function (e) {
        if (!e.target.matches('.bkcoaches-menu-btn')) {
            document.querySelectorAll('.bkcoaches-dropdown').forEach(d => d.classList.remove('show'));
        }
    });

    function viewCoach(id) {
        window.location.href = '/BackOffice/GetApplicantDetails/' + id;
    }

    function editCoach(id) {
        $.ajax({
            url: '/api/BackOfficeAPI/ApproveApplication/' + id,
            headers: { "Authorization": "Bearer " + userToken },
            method: 'PUT',
            success: function () {
                alert("Application approved.");
                loadCoaches(currentPage); // optional reload
            },
            error: function () {
                alert("Approval failed.");
            }
        });
    }

    $(document).ready(function () {
        loadCoaches(currentPage);
    });
</script>