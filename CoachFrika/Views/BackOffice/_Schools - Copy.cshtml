@using CoachFrika.APIs.ViewModel
@using CoachFrika.Common
@model BaseResponse<List<ProfileDto>>
@{
    Layout = null;
    ViewBag.Title = "Schools";

    var statusOptions = new Dictionary<string, string>
    {
        { "", "All Status" },
        { "1", "Ongoing" },
        { "2", "Pending" },
        { "3", "Approved" }
    };
}
<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4);
    }

    .modal-content {
        background-color: #fff;
        margin: 10% auto;
        padding: 20px;
        width: 400px;
        border-radius: 8px;
        position: relative;
    }

        .modal-content input {
            width: 95%;
            padding: 8px;
            margin-bottom: 12px;
        }

        .modal-content button {
            width: 100%;
            padding: 10px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
        }

    .close {
        position: absolute;
        top: 10px;
        right: 15px;
        font-size: 20px;
        cursor: pointer;
    }
</style>

<div class="bkcoaches-container">
    <div class="bkcoaches-header">
        <h2>Schools</h2>
        <div class="bkcoaches-searchbar">
            <input type="text" id="searchName" placeholder="Search by name..." />
            <select id="statusFilter">
                @foreach (var option in statusOptions)
                {
                    <option value="@option.Key">@option.Value</option>
                }
            </select>
            <select id="pageSize">
                <option value="10">10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
                <option value="100">100 per page</option>
            </select>
            <button id="searchBtn">Search</button>
            <button id="createBtn">Create</button>
        </div>
    </div>

    <table class="bkcoaches-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Contact Name</th>
                <th>Contact Number</th>
                <th>Contact Email</th>
                <th>Number of Teachers</th>
                <th>Address</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="8">Loading Schools...</td></tr>
        </tbody>
    </table>

    <div class="bkcoaches-pagination"></div>

    <!-- Modal -->
    <div id="createSchoolModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2>Create New School</h2>
            <form id="createSchoolForm">
                <input type="text" name="SchoolName" placeholder="School Name" required />
                <input type="text" name="SchoolAddress" placeholder="School Address" required />
                <input type="number" name="NumbersOfTeachers" placeholder="Number of Teachers" required />
                <input type="text" name="Goals" placeholder="Goals" />
                <input type="text" name="ContactPersonName" placeholder="Contact Person Name" required />
                <input type="email" name="ContactPersonEmail" placeholder="Contact Person Email" required />
                <input type="text" name="ContactPersonPhoneNumber" placeholder="Contact Person Phone Number" required />
                <button type="submit">Submit</button>
            </form>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let currentPage = 1;

    const modal = document.getElementById("createSchoolModal");
    const form = document.getElementById("createSchoolForm");

    // Open modal
    $('#createBtn').on('click', () => modal.style.display = "block");

    // Close modal
    function closeModal() {
        modal.style.display = "none";
        form.reset();
    }

    // Hide dropdowns when clicking outside
    window.addEventListener('click', function (e) {
        if (!e.target.matches('.bkcoaches-menu-btn')) {
            document.querySelectorAll('.bkcoaches-dropdown').forEach(d => d.classList.remove('show'));
        }
        if (e.target == modal) closeModal();
    });

    // Filter search
    $('#searchBtn').on('click', () => {
        currentPage = 1;
        loadTeachers(currentPage);
    });

    $('#pageSize').on('change', () => {
        currentPage = 1;
        loadTeachers(currentPage);
    });

    // Status Mapping
    function convertStatusToOnboarding(uiStatus) {
        if (uiStatus === "1") return 0;
        if (uiStatus === "2") return 1;
        if (uiStatus === "3") return 2;
        return null;
    }

    // Load Schools
    function loadTeachers(pageNumber) {
        const name = $('#searchName').val();
        const uiStatus = $('#statusFilter').val();
        const pageSize = $('#pageSize').val();
        const onboardingStatus = convertStatusToOnboarding(uiStatus);

        $.ajax({
            url: '/api/BackOfficeAPI/GetAllSchoolApplicant',
            method: 'GET',
            data: {
                Name: name,
                IsCoach: false,
                OnboardingStatus: onboardingStatus,
                PageSize: pageSize,
                PageNumber: pageNumber
            },
            success: function (response) {
                renderTeacherTable(response.data);
                renderPagination(response.totalCount, pageNumber, pageSize);
            },
            error: function () {
                alert("Failed to load schools.");
            }
        });
    }

    function renderTeacherTable(data) {
        const tbody = $('.bkcoaches-table tbody');
        tbody.empty();

        if (!data || data.length === 0) {
            tbody.append('<tr><td colspan="8">No schools found.</td></tr>');
            return;
        }

        data.forEach(teacher => {
            let statusLabel = teacher.stages < 6
                ? 'Ongoing'
                : (teacher.stages === 6 && teacher.hasPaid ? 'Approved' : 'Pending');

            let statusClass = statusLabel.toLowerCase();
            let actionButtons = `
                <button onclick="viewTeacher('${teacher.id}')">View</button>
                ${statusLabel === 'Pending' ? `<button onclick="editTeacher('${teacher.id}')">SchoolTeacher</button>` : ''}
            `;

            tbody.append(`
                <tr>
                    <td>${teacher.schoolName || ''}</td>
                    <td>${teacher.contactPersonName || ''}</td>
                    <td>${teacher.schoolPhoneNumber || ''}</td>
                    <td>${teacher.schoolEmail || ''}</td>
                    <td>${teacher.numbersOfTeachers ?? ''}</td>
                    <td>${teacher.schoolAddress || ''}</td>
                    <td><span class="bkcoaches-status ${statusClass}">${statusLabel}</span></td>
                    <td class="bkcoaches-action">
                        <button class="bkcoaches-menu-btn" onclick="toggleMenu(this)">⋮</button>
                        <div class="bkcoaches-dropdown">${actionButtons}</div>
                    </td>
                </tr>
            `);
        });
    }

    function renderPagination(totalCount, pageNumber, pageSize) {
        const pagination = $('.bkcoaches-pagination');
        pagination.empty();

        const totalPages = Math.ceil(totalCount / pageSize);
        if (totalPages <= 1) return;

        if (pageNumber > 1) {
            pagination.append(`<button class="page-btn" onclick="loadTeachers(${pageNumber - 1})">Prev</button>`);
        }

        for (let i = 1; i <= totalPages; i++) {
            const active = i === pageNumber ? 'active' : '';
            pagination.append(`<button class="page-btn ${active}" onclick="loadTeachers(${i})">${i}</button>`);
        }

        if (pageNumber < totalPages) {
            pagination.append(`<button class="page-btn" onclick="loadTeachers(${pageNumber + 1})">Next</button>`);
        }

        currentPage = pageNumber;
    }

    function toggleMenu(button) {
        document.querySelectorAll('.bkcoaches-dropdown').forEach(d => d.classList.remove('show'));
        const dropdown = button.nextElementSibling;
        dropdown.classList.toggle('show');
    }

    // Submit New School
    form.addEventListener('submit', function (e) {
        e.preventDefault();

        const formData = {
            SchoolName: form.SchoolName.value,
            SchoolAddress: form.SchoolAddress.value,
            NumbersOfTeachers: parseInt(form.NumbersOfTeachers.value),
            Goals: form.Goals.value,
            ContactPersonName: form.ContactPersonName.value,
            ContactPersonEmail: form.ContactPersonEmail.value,
            ContactPersonPhoneNumber: form.ContactPersonPhoneNumber.value
        };

        $.ajax({
            url: '/api/Schools/CreateSchool',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(formData),
            success: function () {
                alert('School created successfully.');
                closeModal();
                loadTeachers(currentPage);
            },
              error: function (xhr) {
        let errorMessage = "Failed to create school.";

        if (xhr.responseJSON && xhr.responseJSON.message) {
            errorMessage = xhr.responseJSON.message;
        } else if (xhr.responseText) {
            try {
                const response = JSON.parse(xhr.responseText);
                if (response.message) {
                    errorMessage = response.message;
                }
            } catch (e) {
                // fallback if JSON parsing fails
                errorMessage = xhr.responseText;
            }
        }

        alert(errorMessage);
    }
        });
    });

    function viewTeacher(id) {
        window.location.href = '/BackOffice/GetApplicantSchoolDetails/' + id;
    }

    function editTeacher(id) {
        $.ajax({
            url: '/api/BackOfficeAPI/ApproveSchoolApplication/' + id,
            method: 'PUT',
            success: function () {
                alert("Application approved.");
                loadTeachers(currentPage);
            },
            error: function () {
                alert("Approval failed.");
            }
        });
    }

    $(document).ready(() => loadTeachers(currentPage));
</script>
