@model UserSignUpViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid p-0 vh-100">
    <div class="row g-0 h-100">
        <!-- Left Column -->
        <div class="col-lg-5 d-none d-lg-block brand-column" onclick="window.location.href='/'"
             style="cursor: pointer;">
                <img src="~/images/coach.png" alt="brand" class="brand-image" />
        </div>


        <!-- Right Column -->
        <div class="col-lg-7 col-md-12 auth-column">
            <div class="container auth-container">
                <div class="auth-wrapper">
                    <div class="auth-header text-center mb-4">
                        <h1 class="auth-title">Sign Up As</h1>
                    </div>

                    <!-- Tabs -->
                    <div class="user-type-tabs mb-4" id="userTypeTabs">
                        <div class="row">
                            <div class="col-6 p-0">
                                <button type="button" class="btn user-type-btn active" data-is-coach="true">COACH</button>
                            </div>
                            <div class="col-6 p-0">
                                <button type="button" class="btn user-type-btn" data-is-coach="false">TEACHER</button>
                            </div>
                        </div>
                    </div>

                    <!-- Sign Up Form -->
                    <form asp-action="SignUp" method="post" class="needs-validation" novalidate>
                        <input type="hidden" name="IsCoach" id="isCoach" value="true" />
                        @Html.ValidationSummary(false, "", new { @class = "text-danger text-center mb-3" })

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Enter Full Name" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="sample@gmail.com" required />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="password-input-group">
                                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••••••••••••" required />
                                <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                    <i class="fas fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="password-input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••••••••••••" required />
                                <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                    <i class="fas fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3" id="signUpBtn" disabled>Sign Up</button>
                    </form>

                    <div class="auth-links text-center">
                        <p>
                            Already have an account?
                            <a asp-action="Login" asp-controller="Account" class="auth-link highlight">Login</a>
                        </p>
                    </div>

                    <div class="text-center mb-2">
                        <p class="auth-divider">Quick Sign Up With</p>
                        <div class="social-login">
                            <button type="button" class="btn btn-social btn-google">
                                <img src="~/images/google.png" alt="Google" width="20" height="20" />
                            </button>
                            <button type="button" class="btn btn-social btn-facebook">
                                <img src="~/images/facebook.png" alt="Facebook" width="10" height="20" />
                            </button>
                            <button type="button" class="btn btn-social btn-twitter">
                                <img src="~/images/twitter.svg" alt="Twitter" width="20" height="20" />
                            </button>
                        </div>
                    </div>

                    <!-- Decorative Dots -->
                    <div class="dots-decoration dots-top-right"></div>
                    <div class="dots-decoration dots-bottom-left"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ JavaScript -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        const requiredInputs = form.querySelectorAll("input[required]");
        const signUpBtn = document.getElementById("signUpBtn");
        const passwordInput = form.querySelector("input[name='Password']");
        const confirmPasswordInput = form.querySelector("input[name='ConfirmPassword']");
        const userTypeInput = document.getElementById("isCoach");

        // Disable button after form submit
        form.addEventListener("submit", function () {
            signUpBtn.disabled = true;
            signUpBtn.innerText = "Submitting...";
        });

        // User type selection
        document.querySelector("#userTypeTabs").addEventListener("click", function (e) {
            if (e.target.classList.contains("user-type-btn")) {
                document.querySelectorAll(".user-type-btn").forEach(btn => btn.classList.remove("active"));
                e.target.classList.add("active");

                // Set hidden input to boolean string
                const isCoachValue = e.target.dataset.isCoach === "true" ? "true" : "false";
                userTypeInput.value = isCoachValue;
            }
        });

        // Password toggle
        document.querySelectorAll(".password-toggle").forEach(toggle => {
            toggle.addEventListener("click", () => {
                const input = toggle.previousElementSibling;
                const icon = toggle.querySelector("i");
                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");
                } else {
                    input.type = "password";
                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");
                }
            });
        });

        // Form validation
        requiredInputs.forEach(input => {
            input.addEventListener("input", validateForm);
        });

        function validateForm() {
            let allFilled = true;
            requiredInputs.forEach(input => {
                if (!input.value.trim()) allFilled = false;
            });

            const passwordsMatch = passwordInput.value === confirmPasswordInput.value;
            signUpBtn.disabled = !(allFilled && passwordsMatch);
        }
    });
</script>

<script src="~/js/auth.js"></script>
