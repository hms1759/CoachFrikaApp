@using CoachFrika.APIs.ViewModel
@model LoginDto
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Login";

}

<div class="container-fluid p-0 vh-100">
    <div class="row g-0 h-100">
        <div class="col-lg-5 d-none d-lg-block brand-column">
            <img src="~/images/coach.png" alt="brand" class="brand-image" />
        </div>

        <div class="col-lg-7 col-md-12 auth-column">
            <div class="container auth-container">
                <div class="auth-wrapper">
                    <div class="auth-header text-center mb-4">
                        <h1 class="auth-title">Login</h1>
                    </div>

                    <!-- Login Form -->
                    <form asp-action="Login" method="post" class="needs-validation" novalidate>

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                        <br />
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" required placeholder="sample@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Password</label>
                            <div class="password-input-group">
                                <input asp-for="Password" type="password" id="password" class="form-control" placeholder="••••••••••••••••••" required />
                                <button type="button" class="password-toggle" aria-label="Toggle password visibility">
                                    <i class="fas fa-eye-slash"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">Login</button>

                        <div class="text-center mb-4">
                            <p class="auth-divider">Login With</p>
                            <div class="social-login">
                                <button type="button" class="btn btn-social btn-google">
                                    <img src="~/images/google.png" alt="Google" width="20" height="20" />
                                </button>
                                <button type="button" class="btn btn-social btn-facebook">
                                    <img src="~/images/facebook.png" alt="Facebook" width="10" height="20" />
                                </button>
                                <button type="button" class="btn btn-social btn-twitter">
                                    <img src="~/images/twitter.svg" alt="Twitter" width="20" height="20" />
                                </button>
                            </div>
                        </div>

                        <div class="auth-links text-center">
                            <a href="#" id="forgotPasswordLink" class="auth-link">Forgot Password?</a>
                            <p class="mt-2">
                                Not a member yet?
                                <a asp-action="SignUp" asp-controller="Account" class="auth-link highlight">Sign Up</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Decorative dots -->
            <div class="dots-decoration dots-top-right"></div>
            <div class="dots-decoration dots-bottom-left"></div>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        const loginButton = form.querySelector("button[type='submit']");

        form.addEventListener("submit", function () {
            loginButton.disabled = true;
            loginButton.innerText = "Logging in..."; // optional feedback
        });
    });
</script>

 
    <script src="~/js/auth.js"></script>
}
