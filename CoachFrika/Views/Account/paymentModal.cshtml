@using CoachFrika.APIs.ViewModel
@model SignpStage1Resp

@{
    Layout = "~/Views/Shared/_modalLayout.cshtml";
}

@Html.AntiForgeryToken()

<script>
    const userToken = '@Model.token';
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Multi-Step Modal</title>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    <!-- Background Blur Layer -->
    <div class="modal-background">
        <img src="~/images/blurbackgd.png" alt="Background" class="modal-bg-img">
    </div>

    <section class="payment-section">

        <h2>Our Packages</h2>
        <p>Choose from our range of subscription plans that best suit your needs</p>
        <div class="payment-cards">
            <!-- Intentional Plan -->
            <div class="payment-card">
                <div class="payment-card-header payment-intentional">Intentional Teacher-Leader</div>
                <div class="payment-price">₦50,000</div>
                <ul class="payment-features">
                    <li><i class="fas fa-check-circle text-success mr-2"></i> 4 Coaching Sessions</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                </ul>
                <button class="payment-button">Choose Plan</button>
            </div>

            <!-- Phenomenal Plan -->
            <div class="payment-card">
                <div class="payment-card-header payment-phenomenal">Phenomenal Teacher-Leader</div>
                <div class="payment-price">₦70,000</div>
                <ul class="payment-features">
                    <li><i class="fas fa-check-circle text-success mr-2"></i> 6 Coaching Sessions</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Join Global Teacher Community</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Exclusive Webinars</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                </ul>
                <button class="payment-button">Choose Plan</button>
            </div>

            <!-- Transformational Plan -->
            <div class="payment-card">
                <div class="payment-card-header payment-transformational">Transformational Teacher-Leader</div>
                <div class="payment-price">₦100,000</div>
                <ul class="payment-features">
                    <li><i class="fas fa-check-circle text-success mr-2"></i> 9 Coaching Sessions</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Resource Library</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Access to Join Global Teacher Community</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate of Participation</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Exclusive Webinars</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> 3 Months Mentorship</li>
                    <li><i class="fas fa-check-circle text-success mr-2"></i> Certificate</li>
                </ul>
                <button class="payment-button">Choose Plan</button>
            </div>
        </div>
    </section>
    


    <script src="~/js/modal-script.js"></script>
</body>
</html>
