@using CoachFrika.APIs.ViewModel
@model SignpStage1Resp
@{
    var stepToShow = Model.Stage + 1;
    var stepId = $"modalStep{stepToShow}";
}
@{
    Layout = "";

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Multi-Step Modal</title>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

<!-- Background Blur Layer -->
<div class="modal-background">
    <img src="~/images/blurbackgd.png" alt="Background" class="modal-bg-img">
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="modal-overlay">

    <!-- Step 1 -->
    <div id="modalStep1" class="modal-box modal-visible">
        <button class="modal-close-btn" onclick="ModalApp.close()">×</button>
            <h2 class="modal-heading">Welcome @Model.FullName!</h2>
        <p class="modal-subtext">Let us quickly set up your profile</p>
        <div class="modal-steps">
            <div class="modal-step modal-active">1</div>
            <div class="modal-step">2</div>
            <div class="modal-step">3</div>
            <div class="modal-step">4</div>
            <div class="modal-step">5</div>
        </div>
        <div class="modal-form">
            <label for="modalTitle">Tell us about yourself</label>
            <select id="modalTitle">
                <option value="">Select your Title</option>
                <option>Mr</option>
                <option>Mrs</option>
                <option>Miss</option>
                </select>
                <input type="text" class="contact-input" name="ProfessionalTitle" placeholder="Professional Title" required />
                <button class="modal-next-btn" data-step="1" onclick="ModalApp.submitStep(this)">Save and Continue</button>

        </div>
    </div>

    <!-- Step 2 -->
    <div id="modalStep2" class="modal-box">
            <button class="modal-close-btn" onclick="ModalApp.close()">×</button>
            <h2 class="modal-heading">Hi @Model.FullName!</h2>
        <h2 class="modal-heading">More Details</h2>
        <p class="modal-subtext">Help us know you better</p>
        <div class="modal-steps">
            <div class="modal-step modal-active">1</div>
            <div class="modal-step modal-active">2</div>
            <div class="modal-step">3</div>
            <div class="modal-step">4</div>
            <div class="modal-step">5</div>
        </div>
            <div class="modal-form">
                <label for="modalTitle">Tell us about yourself</label>
                <input type="text" class="contact-input" name="PhoneNumber" placeholder="Phone Number" required />
                <input type="text" class="contact-input" name="NumberOfStudent" placeholder="Number Of Student" required />
                <input type="text" class="contact-input" name="YearOfExperience" placeholder="Year Of Experience" required />

                <button class="modal-next-btn" data-step="1" onclick="ModalApp.submitStep(this)">Save and Continue</button>
        </div>
    </div>

    <!-- Step 3 -->
    <div id="modalStep3" class="modal-box">
            <button class="modal-close-btn" onclick="ModalApp.close()">×</button>
            <h2 class="modal-heading">Hi @Model.FullName!</h2>
        <h2 class="modal-heading">Almost There</h2>
        <p class="modal-subtext">A few more questions...</p>
        <div class="modal-steps">
            <div class="modal-step modal-active">1</div>
            <div class="modal-step modal-active">2</div>
            <div class="modal-step modal-active">3</div>
            <div class="modal-step">4</div>
            <div class="modal-step">5</div>
        </div>
            <div class="modal-form">
                <label for="modalTitle">Tell us about yourself</label>
                <input type="text" class="contact-input" name="StateOfOrigin" placeholder="State Of Origin" required />
                <input type="text" class="contact-input" name="Nationality" placeholder="Nationality" required />
                <textarea  id="Description" placeholder="Enter your background information" required />

                <button class="modal-next-btn" data-step="1" onclick="ModalApp.submitStep(this)">Save and Continue</button>
        </div>
    </div>

    <!-- Step 4 -->
    <div id="modalStep4" class="modal-box">
            <button class="modal-close-btn" onclick="ModalApp.close()">×</button>
            <h2 class="modal-heading">Hi @Model.FullName!</h2>
        <h2 class="modal-heading">Almost There</h2>
        <p class="modal-subtext">A few more questions...</p>
        <div class="modal-steps">
            <div class="modal-step modal-active">1</div>
            <div class="modal-step modal-active">2</div>
            <div class="modal-step modal-active">3</div>
            <div class="modal-step modal-active">4</div>
            <div class="modal-step">5</div>
        </div>
            <div class="modal-form">
                
                <label for="modalGoals">Your Social Medial Links</label>
                <input type="text" class="contact-input" name="TweeterUrl" placeholder="Tweeter" required />
                <input type="text" class="contact-input" name="LinkedInUrl" placeholder="LinkedIn" required />
                <input type="text" class="contact-input" name="InstagramUrl" placeholder="Instagram" required />
                <input type="text" class="contact-input" name="FacebookUrl" placeholder="Facebook" required />

                <button class="modal-next-btn" data-step="1" onclick="ModalApp.submitStep(this)">Save and Continue</button>
        </div>
    </div>

    <!-- Step 5 -->
    <div id="modalStep5" class="modal-box">
            <button class="modal-close-btn" onclick="ModalApp.close()">×</button>
            <h2 class="modal-heading">Hi @Model.FullName!</h2>
        <h2 class="modal-heading">Almost There</h2>
        <p class="modal-subtext">A few more questions...</p>
        <div class="modal-steps">
            <div class="modal-step modal-active">1</div>
            <div class="modal-step modal-active">2</div>
            <div class="modal-step modal-active">3</div>
            <div class="modal-step modal-active">4</div>
            <div class="modal-step modal-active">5</div>
        </div>
        <div class="modal-form">
                <label for="modalGoals">Enter Your School Details</label>
                
                <input type="text" class="contact-input" name="SchoolNameLocalGov" placeholder="SchoolName" required />
                <input type="text" class="contact-input" name="LocalGov" placeholder="LocalGov" required />
                <select class="form-control" id="subjectsSelect" name="Subjects" multiple="multiple" required></select>

                <button class="modal-next-btn" data-step="1" onclick="ModalApp.submitStep(this)">Save and Continue</button>
        </div>
    </div>

    <!-- Step 5 -->
    <div id="modalStep5" class="modal-box">
        
    </div>
</div>
    <script>
        const ModalApp = {
            submitStep: async function (btn) {
                const step = btn.getAttribute('data-step');
                btn.disabled = true;
                btn.textContent = 'Saving...';

                // Collect data from current modal (adjust selectors as needed)
                const modal = document.getElementById(`modalStep${step}`);
                const inputs = modal.querySelectorAll('input, textarea, select');
                const formData = {};

                inputs.forEach(input => {
                    if (input.name || input.id) {
                        const key = input.name || input.id;
                        formData[key] = input.value;
                    }
                });

                try {
                    const response = await fetch(`/Teachers/CreateStage${step}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify(formData)
                    });

                    if (response.ok) {
                        // Move to the next step
                        ModalApp.next();
                    } else {
                        alert('Something went wrong.');
                    }
                } catch (error) {
                    console.error(error);
                    alert('Error submitting data.');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Save and Continue';
                }
            },

            next: function () {
                const current = document.querySelector('.modal-box.modal-visible');
                if (!current) return;

                const allSteps = [...document.querySelectorAll('.modal-box')];
                const currentIndex = allSteps.indexOf(current);
                if (currentIndex >= 0 && currentIndex < allSteps.length - 1) {
                    current.classList.remove('modal-visible');
                    allSteps[currentIndex + 1].classList.add('modal-visible');
                }
            },

            close: function () {
                document.querySelectorAll('.modal-box').forEach(modal => modal.classList.remove('modal-visible'));
            }
        };

    </script>
    <script>
        $(document).ready(function () {
            $('#subjectsSelect').select2({
                placeholder: "Select or type subjects",
                tags: true,
                tokenSeparators: [',', ' ']
            });
        });
    </script>
<script src="~/js/modal-script.js"></script>

</body>
</html>
