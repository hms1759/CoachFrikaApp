@using CoachFrika.APIs.ViewModel
@model SignpStage1Resp
@{
    var stepToShow = Model.Stage + 1;
    var stepId = $"modalStep{stepToShow}";
}
@{
    Layout = "~/Views/Shared/_modalLayout.cshtml";
}
@Html.AntiForgeryToken()
<script>
    const userToken = '@Model.token';
</script>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Multi-Step Modal</title>

    <!-- Site & Toastr CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- ✅ Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <!-- ✅ jQuery (already included) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- ✅ Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body>

    <!-- Background Blur Layer -->
    <div class="modal-background">
        <img src="~/images/blurbackgd.png" alt="Background" class="modal-bg-img">
    </div>

    <!-- Modal Overlay (Steps 1–7) -->
    <div id="modalOverlay" class="modal-overlay">

        <!-- Modal Steps Here... [UNTOUCHED from your version] -->
        @* You can paste all modalStep1 to modalStep7 here from your original code since that HTML hasn't changed *@

    </div>

    <!-- jQuery & Toastr -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- Toastr Config -->
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "5000"
        };
    </script>

    <!-- Modal Logic with Toastr Alerts -->
    <script>
        const ModalApp = {
            submitStep: async function (btn) {
                const step = btn.getAttribute('data-step');
                btn.disabled = true;
                btn.textContent = 'Saving...';

                const modal = document.getElementById(`modalStep${step}`);
                const inputs = modal.querySelectorAll('input, textarea, select');
                const formData = {};
                let emptyFields = [];

                inputs.forEach(input => {
                    const key = input.name || input.id;
                    const value = input.value.trim();
                    formData[key] = value;

                    if (input.hasAttribute('required') && !input.hasAttribute('readonly') && (value === '' || value == null)) {
                        emptyFields.push(key);
                    }
                });

                if (formData['Subjects']) {
                    formData['Subjects'] = $('#subjectsSelect').val();
                }

                if (emptyFields.length > 0) {
                    toastr.warning(`Please fill in all required fields before continuing: ${emptyFields.join(', ')}`);
                    btn.disabled = false;
                    btn.textContent = 'Save and Continue';
                    return;
                }

                try {
                    const response = await fetch(`/api/Teachers/CreateStage${step}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${userToken}`,
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify(formData)
                    });

                    if (response.ok) {
                        ModalApp.next();
                    } else {
                        toastr.error('Something went wrong while saving this step.');
                    }
                } catch (error) {
                    console.error(error);
                    toastr.error('Error submitting data.');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Save and Continue';
                }
            },

            submitStep6: async function (btn) {
                const plan = btn.getAttribute('data-plan');
                const step = 6;
                const formData = { Plan: parseInt(plan) };

                btn.disabled = true;
                btn.textContent = 'Saving...';

                try {
                    const response = await fetch(`/api/Teachers/CreateStage${step}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${userToken}`,
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify(formData)
                    });

                    if (response.ok) {
                        document.querySelectorAll('.modal-box').forEach(modal => modal.classList.remove('modal-visible'));

                        const packageSection = document.querySelector('.packages-section');
                        if (packageSection) {
                            packageSection.style.display = 'none';
                        }

                        const finalStep = document.getElementById('modalStep7');
                        if (finalStep) {
                            finalStep.classList.add('modal-visible');
                        } else {
                            toastr.success('Plan selected successfully!');
                        }
                    } else {
                        const errorData = await response.json();
                        toastr.error(`Error: ${errorData.message || 'Unable to select plan.'}`);
                    }

                } catch (error) {
                    console.error(error);
                    toastr.error('Error occurred while selecting plan.');
                } finally {
                    btn.disabled = false;
                    btn.textContent = 'Choose Plan';
                }
            },

            next: function () {
                const current = document.querySelector('.modal-box.modal-visible');
                if (!current) return;

                const allSteps = [...document.querySelectorAll('.modal-box')];
                const currentIndex = allSteps.indexOf(current);
                if (currentIndex >= 0 && currentIndex < allSteps.length - 1) {
                    current.classList.remove('modal-visible');
                    allSteps[currentIndex + 1].classList.add('modal-visible');
                }
            },

            close: function () {
                document.querySelectorAll('.modal-box').forEach(modal => modal.classList.remove('modal-visible'));
            }
        };
    </script>

    <!-- Initialize Select2 -->
    <script>
        $(document).ready(function () {
            if ($('#subjectsSelect').length > 0) {
                $('#subjectsSelect').select2({
                    placeholder: "Select or type subjects",
                    tags: true,
                    tokenSeparators: [',', ' ']
                });
            } else {
                console.warn("#subjectsSelect not found");
            }

            // Toastr sample usage (you can remove this)
            toastr.success("Page loaded and Select2 initialized successfully!");

            // Submit handler (optional)
            $('#createRecommendationForm').on('submit', function (e) {
                e.preventDefault();
                let title = $('#title').val();
                let subjects = $('#subjectsSelect').val();

                if (!title || subjects.length === 0) {
                    toastr.error("Please enter title and select at least one subject.");
                    return;
                }

                // Simulate success
                toastr.success("Recommendation submitted!");
                console.log("Submitted:", { title, subjects });
            });
        });
    </script>

</body>
</html>
